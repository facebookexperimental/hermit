rust_unittest(
    name = "tests_time",
    srcs = ["tests/time/mod.rs"],
    crate_root = "tests/time/mod.rs",
    env = test_env,
    link_style = "static_pic",  # [global_allocator] requires static linkage to function
    rustc_flags = sanitized_feature,
    deps = [
        "fbsource//third-party/rust:chrono",
        "fbsource//third-party/rust:libc",
        ":detcore",
        ":detcore-testutils",
        "//hermetic_infra/hermit/common/test-allocator:test-allocator",
        "//hermetic_infra/reverie:reverie",
        "//hermetic_infra/reverie:reverie-ptrace",
    ],
)

export_file(
    name = "musl_srcs",
    src = "tests/testdata/musl-1.2.1.tar.gz",
)

buck_sh_test(
    name = "test_build_musl_detcore",
    args = [
        "$(location :musl_srcs)",
        "$(location //hermetic_infra/hermit/hermit-cli:hermit)",
        "run",
    ],
    test = "tests/scripts/test_build_musl.sh",
    deps = [
        ":musl_srcs",
    ],
)

rust_binary(
    name = "syscaller",
    srcs = ["scripts/syscaller.rs"],
    deps = [
        "fbsource//third-party/rust:libc",
    ],
)

# This target is meant to be executed with `buck run` and
# be used a reporting script that automatically find all
# required targets and setup conditions.
# buck_sh_binary(), buck_python_binary() cannot expand
# `location` macros and they cannot pass args.
# buck_python_test() is also coming with the limitation that
# doesn't support args.
buck_sh_test(
    name = "get-syscall-support",
    args = [
        "$(location //hermetic_infra/hermit/hermit-cli:hermit)",
        "$(location :syscaller)",
    ],
    # This is for buck test to ignore this target
    # as this target is meant for `buck run` only.
    labels = [tpx_labels.test_is_invisible_to_testpilot],
    test = "scripts/get_syscall_support.py",
    deps = [
        ":syscaller",
    ],
)
