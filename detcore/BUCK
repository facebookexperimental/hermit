rust_unittest(
    name = "tests_time",
    srcs = ["tests/time/mod.rs"],
    crate_root = "tests/time/mod.rs",
    env = test_env,
    # Run by :tests_time-gated (fb-only/gated_tests).
    labels = run_gated_only(),
    link_style = "static_pic",  # [global_allocator] requires static linkage to function
    named_deps = {"reverie": "//hermetic_infra/reverie:reverie"},
    run_env = test_run_env,
    rustc_flags = sanitized_feature,
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    deps = [
        "fbsource//third-party/rust:chrono",
        "fbsource//third-party/rust:libc",
        ":detcore",
        ":detcore-testutils",
        "//hermetic_infra/hermit/common/test-allocator:test-allocator",
        "//hermetic_infra/hermit/detcore-model:detcore-model",
        "//hermetic_infra/reverie:reverie-ptrace",
    ],
)

gated_test(
    name = "tests_time-gated",
    # tod_clock_getres_2 fails on RE workers (measured 2026-10-28, re-cpuid RE pass); keep local pending investigation.
    allow_cpuid_re = False,
    env = test_env | test_run_env,
    test = "//hermetic_infra/hermit/detcore:tests_time",
)

export_file(
    name = "musl_srcs",
    src = "tests/testdata/musl-1.2.1.tar.gz",
)

buck_sh_test(
    name = "test_build_musl_detcore",
    args = [
        "$(location :musl_srcs)",
        "$(location //hermetic_infra/hermit/hermit-cli:hermit)",
        "run",
        # The script unpacks and configures Musl in a host mktemp directory
        # under /tmp, then builds it under Hermit from build/ next to the
        # sources. Hermit replaces guest /tmp with an empty isolated directory,
        # which hides the sources; mount the host /tmp as the guest /tmp.
        "--tmp=/tmp",
    ],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    test = "tests/scripts/test_build_musl.sh",
    deps = [
        ":musl_srcs",
    ],
)

rust_binary(
    name = "syscaller",
    srcs = ["scripts/syscaller.rs"],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    deps = [
        "fbsource//third-party/rust:libc",
    ],
)

# This target is meant to be executed with `buck run` and
# be used a reporting script that automatically find all
# required targets and setup conditions.
# buck_sh_binary(), buck_python_binary() cannot expand
# `location` macros and they cannot pass args.
# buck_python_test() is also coming with the limitation that
# doesn't support args.
buck_sh_test(
    name = "get-syscall-support",
    args = [
        "$(location //hermetic_infra/hermit/hermit-cli:hermit)",
        "$(location :syscaller)",
    ],
    # This is for buck test to ignore this target
    # as this target is meant for `buck run` only.
    labels = [tpx_labels.test_is_invisible_to_testpilot],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    test = "scripts/get_syscall_support.py",
    deps = [
        ":syscaller",
    ],
)

# detcore/tests/**/*.rs, the detcore root of check.exit_status_class's scan;
# tests/lit is its own package.
buck_filegroup(
    name = "tests-rust",
    srcs = {"tests/lit": "//hermetic_infra/hermit/detcore/tests/lit:guest-sources"} | {src: src for src in glob(["tests/**/*.rs"])},
    visibility = ["//hermetic_infra/hermit:"],
)

# detcore/tests/fixtures: C guests hermit-cli's integration tests compile at
# run time from their CARGO_MANIFEST_DIR (chosen_terminal.rs).
buck_filegroup(
    name = "tests-fixtures",
    srcs = {path[len("tests/fixtures/") :]: path for path in glob(["tests/fixtures/**"])},
    visibility = ["//hermetic_infra/hermit:"],
)

# detcore/src, which check.backend_abstraction's source gate scans, keyed
# relative to src/ so that it materializes where it is mapped.
buck_filegroup(
    name = "backend-abstraction-src",
    srcs = {path[len("src/") :]: path for path in glob(["src/**"])},
    visibility = ["//hermetic_infra/hermit:"],
)

# The Cargo manifests of this package's workspace members, for the tree
# check.backend_abstraction runs on
# (//hermetic_infra/hermit:backend-abstraction-repository).
[
    buck_export_file(
        name = manifest,
        visibility = ["//hermetic_infra/hermit:"],
    )
    for manifest in [
        "Cargo.toml",
        "tests/Cargo.toml",
        "tests/lit-guests/Cargo.toml",
        "tests/testutils/Cargo.toml",
    ]
]
