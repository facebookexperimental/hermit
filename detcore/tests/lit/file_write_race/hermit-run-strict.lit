// Strict mode serializes the two writers, so the file holds one thread's ten
// bytes followed by the other's. Which thread goes first depends on which side
// of the clone runs first (--runs-post-fork), not on this test, so the default
// run accepts either order and checks determinism with --verify; a
// parent-first run pins its order.
RUN: %hermit run --env=TMPDIR=/tmp -- %me | FileCheck %s
RUN: %hermit run --env=TMPDIR=/tmp --verify -- %me
RUN: %hermit run --env=TMPDIR=/tmp --runs-post-fork=parent -- %me | FileCheck --check-prefix=PARENT %s
CHECK: {{^(1{10}2{10}|2{10}1{10})$}}
PARENT: {{^2{10}1{10}$}}
