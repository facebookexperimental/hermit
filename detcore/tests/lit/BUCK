load("@bazel_skylib//lib:paths.bzl", "paths")
load("@fbcode//hermetic_infra/hermit/fb-only/gated_tests:defs.bzl", "hermit_host_lit_test")
load("@fbcode_macros//build_defs:native_rules.bzl", "buck_filegroup")
load("build_defs.bzl", "LIT_TEST_ENV", "cpp_lit_unittest", "go_lit_unittest", "rust_lit_unittest")

oncall("hermit")

# Pure lit tests. These have no dependencies on anything else except `hermit
# run`, whose ptrace backend needs CPUID faulting: each is admitted by the
# cpuid-faulting probe.
[
    hermit_host_lit_test(
        name = p.replace(".", "_"),
        env = LIT_TEST_ENV,
        lit_args = ["--show-all"],
        subs = [
            ("hermit", "//hermetic_infra/hermit/hermit-cli:hermit"),
        ],
        test = p,
    )
    for p in glob([
        "*.test",
        "scheduler_strategies/*.sh",
    ])
]

# C/C++ tests.
[
    [
        cpp_lit_unittest(
            name = paths.dirname(p).replace(".", "_"),
            src = p,
            compiler_flags = [
                "-D_POSIX_C_SOURCE=20180920",
                "-D_GNU_SOURCE=1",
            ],
            # Set NDEBUG to prevent `assert` macros from being compiled out.
            preprocessor_flags = ["-UNDEBUG"],
        ),
    ]
    for p in glob([
        "*/main.c",
        "*/main.cpp",
    ])
]

# Rust lit tests.
[
    [
        rust_lit_unittest(
            name = paths.dirname(p).replace(".", "_"),
            src = p,
            deps = [
                "fbsource//third-party/rust:close-err",
                "fbsource//third-party/rust:libc",
                "fbsource//third-party/rust:nix",
                "fbsource//third-party/rust:syscalls",
                "fbsource//third-party/rust:tempfile",
            ],
        ),
    ]
    for p in glob([
        "*/main.rs",
    ])
]

# Go lit tests
[
    [
        go_lit_unittest(
            name = paths.dirname(p).replace(".", "_"),
            src = p,
            deps = [],
        ),
    ]
    for p in glob([
        "*/main.go",
    ])
]

# Guest sources for hermit-cli's Cargo integration tests (see
# //hermetic_infra/hermit:integration-repository), and part of the tree
# check.exit_status_class scans (//hermetic_infra/hermit/detcore:tests-rust).
buck_filegroup(
    name = "guest-sources",
    srcs = glob(["**"], exclude = ["BUCK", "*.bzl"]),
    visibility = [
        "//hermetic_infra/hermit:",
        "//hermetic_infra/hermit/detcore:",
    ],
)
