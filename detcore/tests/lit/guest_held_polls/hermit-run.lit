RUN: %hermit --log info run -- %me same |& awk '/^same:/ {print} /polls_guest_state_only: true/ {n++} /guest-held marks no longer count/ {r=1} END {print "classified polls: " (n > 0 ? "some" : "none"); print "marks revoked: " (r ? "yes" : "no")}' | FileCheck --check-prefix=SAME %s
SAME: same: revents 0x1
SAME-NEXT: classified polls: some
SAME-NEXT: marks revoked: no
