load(":defs.bzl", "hermit_execution_platforms")

oncall("open_source")

# Build execution platforms. Select one with
#   -c build.execution_platforms=gh_facebook_buck2_shims_meta//platforms:<name>
# (shim/modes/* does this). The default, prelude//platforms:default, stays local.
[
    hermit_execution_platforms(
        name = mode,
        cpu_configuration = "prelude//cpu:x86_64",
        mode = mode,
        os_configuration = "prelude//os:linux",
        use_case = read_root_config("hermit", "re_use_case", "buck2-default"),
        visibility = ["PUBLIC"],
    )
    for mode in ["local", "hybrid", "remote"]
]
