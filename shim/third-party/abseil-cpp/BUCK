load("@//third-party:defs.bzl", "pkgconfig_system_library")

oncall("open_source")

# One target per abseil component the vendored gVisor tests use
# (third-party/gvisor-syscall-tests/build/targets.json). Target names match
# fbsource//third-party/abseil-cpp so one label serves both builds;
# pkg-config names follow abseil's own .pc files, and inter-component
# dependencies ride in each .pc file's Requires. Inside the hermetic
# validation image these must resolve from the image's pinned packages
# (ci/hermetic/flake.nix), never from the host or the network.

pkgconfig_system_library(
    name = "algorithm__container",
    pkgconfig_name = "absl_algorithm_container",
    packages = {
        "//os:linux-fedora": ["abseil-cpp-devel"],
        "//os:linux-ubuntu": ["libabsl-dev"],
        "//os:macos-homebrew": ["abseil"],
    },
)

