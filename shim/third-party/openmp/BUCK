load("@//third-party:defs.bzl", "system_library")

oncall("open_source")

# The OSS C/C++ toolchain uses GCC, as does the numerical E2E guest build.
# Enable OpenMP during compilation as well as linking so parallel pragmas
# execute through GCC's existing runtime rather than becoming serial code.
system_library(
    name = "omp",
    exported_preprocessor_flags = ["-fopenmp"],
    exported_linker_flags = ["-fopenmp"],
)
