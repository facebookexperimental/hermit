load("@//third-party:defs.bzl", "pkgconfig_system_library")

oncall("open_source")

pkgconfig_system_library(
    name = "unwind",
    packages = {
        "//os:linux-fedora": ["libunwind-devel"],
        "//os:linux-ubuntu": ["libunwind-dev"],
        "//os:macos-homebrew": ["libunwind"],
    },
    pkgconfig_name = "libunwind",
)

# The ptrace flavour of libunwind, used for remote backtraces. It ships in the
# same distribution packages as the library above and has its own pkg-config
# name.
pkgconfig_system_library(
    name = "unwind-ptrace",
    packages = {
        "//os:linux-fedora": ["libunwind-devel"],
        "//os:linux-ubuntu": ["libunwind-dev"],
        "//os:macos-homebrew": ["libunwind"],
    },
    pkgconfig_name = "libunwind-ptrace",
)
