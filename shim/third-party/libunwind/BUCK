load("@//third-party:defs.bzl", "host_system_libraries")

oncall("open_source")

# unwind-ptrace is the ptrace flavour of libunwind, used for remote backtraces. It ships
# in the same distribution packages and has its own pkg-config name.
host_system_libraries(
    libraries = {
        "unwind": ("libunwind", ["-lunwind"]),
        "unwind-ptrace": ("libunwind-ptrace", ["-l:libunwind-ptrace.a", "-lunwind-generic"]),
    },
    packages = {
        "//os:linux-fedora": ["libunwind-devel"],
        "//os:linux-ubuntu": ["libunwind-dev"],
        "//os:macos-homebrew": ["libunwind"],
    },
)
