#!/usr/bin/env bash
# Reverie pin, pre-commit. THIS IS NOT A HARD BLOCKER ON PIN CURRENCY.
#
# It used to be, and it refused commits touching zero Cargo files. Owner ruling
# 2026-08-08: enforcement belongs to CI (check.reverie_pin, ancestry +
# monotonicity); this surface is awareness only, in exactly four cases:
#
#   1. commit does not touch pin entries           -> SILENT
#   2. touches them and bumps all the way to master -> SILENT
#   3. touches them and bumps but STOPS SHORT       -> ask for acknowledgement,
#      clearable with HERMIT_PIN_BELOW_MASTER_ACK=1. Proceedable, not a refusal.
#   4. regresses the pin                            -> SILENT; CI hard-refuses it
#
# Rarity is the point: it fires only on deliberate pin edits, so it stays
# readable instead of decaying into a reflex flag. Do not widen it.
#
# What DOES still block here is offline-decidable local incoherence: manifests
# disagreeing with each other, and LiteInst cache keys not tracking the pin.
# Those are never fixed by waiting and never involve the network.

set -u
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
checker="$root/ci/run-reverie-pin-check.sh"

if [[ ! -f "$checker" ]]; then
  echo "REVERIE PIN LINT: checker missing at $checker -- BLOCKED" >&2
  exit 1
fi

cd "$root" || exit 1

proxy=()
if command -v with-proxy >/dev/null 2>&1; then
  proxy=(with-proxy)
fi

# Offline, always-blocking: local coherence only. No network, no currency.
"$checker" --repo "$root" --offline || exit 1

# Networked, never a hard refusal: the four-case advisory above. A network
# failure must not block a commit, so a non-1 exit (checker error, no proxy,
# offline laptop) is ignored rather than propagated.
advisory_status=0
"${proxy[@]}" "$checker" --repo "$root" --staged-pin-advisory || advisory_status=$?
if [[ $advisory_status -eq 1 ]]; then
  exit 1
fi

# Also guard the nested-workspace lockfile against pin drift once its checker is
# present (lands separately as rrnewton/hermit#1609). Until then this is a no-op.
nested="$root/scripts/check-nested-lockfiles.rs"
if [[ -x "$nested" ]]; then
  "${proxy[@]}" "$nested" || exit 1
fi

exit 0
