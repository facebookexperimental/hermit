#!/usr/bin/env bash
# Block Hermit commits whose Reverie dependency pin is not latest Reverie main.
# See scripts/check-reverie-pin.rs and docs/updating-reverie.md.

set -u
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
checker="$root/scripts/check-reverie-pin.rs"

if [[ ! -f "$checker" ]]; then
  echo "REVERIE PIN LINT: checker missing at $checker -- BLOCKED" >&2
  exit 1
fi

cd "$root" || exit 1

proxy=()
if command -v with-proxy >/dev/null 2>&1; then
  proxy=(with-proxy)
fi

"${proxy[@]}" "$checker" || exit 1

# Also guard the nested-workspace lockfile against pin drift once its checker is
# present (lands separately as rrnewton/hermit#1609). Until then this is a no-op.
nested="$root/scripts/check-nested-lockfiles.rs"
if [[ -x "$nested" ]]; then
  "${proxy[@]}" "$nested" || exit 1
fi

exit 0
