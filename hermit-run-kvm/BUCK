load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("hermit")

# Hermit's KVM run and the root of its Detcore instantiation, compiled apart
# from the hermit library so it builds in parallel.
rust_library(
    name = "hermit-run-kvm",
    srcs = glob(["src/**/*.rs"]),
    autocargo = {"cargo_toml_dir": "."},
    deps = [
        "//hermetic_infra/hermit/detcore:detcore",
        "//hermetic_infra/reverie:reverie-kvm",
    ],
)
