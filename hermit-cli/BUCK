hermit_release_aliases()

# The guest of the real_random ptrace-completion cases
# (src/ptrace_random_failure_tests.rs), built from the C source a Cargo run
# compiles with the host `cc`. The cases name the x86-64-v2 CPU profile, and
# Detcore's per-exec ISA check refuses an executable or program interpreter
# that declares more; a host `cc` whose objects declare x86-64-v3 builds a
# guest that check refuses. :libhermit-unittest-gated passes this one instead.
cpp_binary(
    name = "random-copy-fatal-guest",
    srcs = ["tests/fixtures/random_copy_fatal.c"],
    # The system allocator: fbcode's default jemalloc starts a background
    # thread (see :libhermit-unittest), and the cases assert that the guest
    # runs exactly two threads.
    allocator = "malloc",
    # A self-contained link, as :hermit and :hermit-dap: no shared libraries
    # from the build output for the guest's loader to open under the cases'
    # capped debug log. fbcode's cpp_binary names its link style this way.
    link_group_map = [],
    overridden_link_style = "static_pic",
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

# The dynamically linked echo that src/lib.rs's
# kvm_runs_dynamic_echo_through_detcore runs under the KVM backend, which runs
# only x86-64-v2 guests: a host /bin/echo may declare x86-64-v3. The test
# asserts that this image has a program interpreter and does not resolve to
# x86-64-v3. liteinst_public_dispatch_runs_in_guest_detcore runs it in place of
# the host's /bin/echo and, with `-n` alone, of /bin/true, where it runs at
# all: fb-only/gated_tests/gates.bzl excludes it by policy, since fbsource does
# not build the in-guest runtime. :libhermit-unittest-gated passes this
# fixture through HERMIT_TEST_DYNAMIC_ECHO.
cpp_binary(
    name = "dynamic-echo-guest",
    srcs = ["tests/fixtures/dynamic_echo.c"],
    # The system allocator: fbcode's default jemalloc would start a background
    # thread in the guest.
    allocator = "malloc",
    # fbcode's own libraries are linked in, while the C library and its
    # program interpreter stay dynamic, so the image loads through the dynamic
    # loader without a shared-library tree beside it. No link groups either,
    # as for :random-copy-fatal-guest.
    link_group_map = [],
    overridden_link_style = "static",
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

gated_test(
    name = "libhermit-unittest-gated",
    # The guests some unit tests launch in place of host programs, set only
    # here and not in LIBHERMIT_TEST_RUN_ENV: this target is the only route
    # CI uses to run these unit tests, and the open-source build, whose
    # gated_test defines nothing, keeps its :libhermit-unittest on the host
    # programs and the host `cc`, as Cargo does, and never loads tests/BUCK
    # for it.
    #   HERMIT_RANDOM_FAILURE_GUEST: the real_random cases' guest.
    #   HERMIT_TEST_DYNAMIC_ECHO: liteinst_public_dispatch_runs_in_guest_detcore's
    #   guest, and kvm_runs_dynamic_echo_through_detcore's where no v2 fixture
    #   (below) is named.
    #   HERMIT_TEST_V2_ROOTFS: the pinned CentOS 9 loader and C library
    #   kvm_runs_dynamic_echo_through_detcore compiles and launches its echo
    #   through, so the guest starts from an x86-64-v2 userland on every
    #   host image. That one guest is compiled by the test image's host cc
    #   at run time (its startup objects are the host's; the link binds
    #   symbol versions from the fixture C library itself), unlike the
    #   prebuilt guests above: no fbcode toolchain links a dynamic guest
    #   against an x86-64-v2 glibc.
    #   HERMIT_UNIT_GUEST: the freestanding guest launched in place of the
    #   host's /bin/sh and /bin/echo (crate::unit_guest).
    env = LIBHERMIT_TEST_RUN_ENV
    | {
        "HERMIT_RANDOM_FAILURE_GUEST": "$(location :random-copy-fatal-guest)",
        "HERMIT_TEST_DYNAMIC_ECHO": "$(location :dynamic-echo-guest)",
        "HERMIT_TEST_V2_ROOTFS": "$(location //hermetic_infra/hermit/fb-only/v2_rootfs:glibc-fixture)",
        "HERMIT_UNIT_GUEST": "$(location //hermetic_infra/hermit/tests:unit_guest)",
    },
    # Match the native Rust test provider: fixtures are project-relative.
    labels = ["buck2_run_from_project_root"],
    test = "//hermetic_infra/hermit/hermit-cli:libhermit-unittest",
)

# Cargo's src/bin/hermit-dap.rs; the CLI integration tests run it.
rust_binary(
    name = "hermit-dap",
    srcs = [
        "src/bin/hermit-dap.rs",
        "src/bin/hermit-dap-reverse.py",
    ],
    autocargo = {"ignore_rule": True},
    crate_root = "src/bin/hermit-dap.rs",
    # Match :hermit above: a self-contained link, so the staged copy beside
    # :hermit (hermit-and-hermit-dap) does not depend on shared libraries
    # the copy does not carry. Without this the staged hermit-dap fails in
    # the dynamic loader (libunwind.so.8) before it can run.
    link_group_map = [],
    link_style = "static_pic",
    deps = [
        "fbsource//third-party/rust:libc",
        "fbsource//third-party/rust:nix",
        "fbsource//third-party/rust:serde_json",
    ],
)

# hermit and hermit-dap copied into one directory, as Cargo builds them. Each
# starts the other from beside its own executable, which a link to either
# output cannot provide. The CLI integration tests stage both from here.
buck_genrule(
    name = "hermit-and-hermit-dap",
    out = "bin",
    cmd = "mkdir -p $OUT && cp $(location :hermit) $OUT/hermit && cp $(location :hermit-dap) $OUT/hermit-dap",
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

# hermit with the LiteInst in-guest runtimes staged as an installation
# layout (hermit-resources: the executable's directory holds rsrcs/).
# This is an UNQUALIFIED layout, not a complete installation: the Detcore
# runtime and its receipt come from the root package's
# :detcore-liteinst-staged, which runs the unchanged Cargo finalizer over
# the Buck-built .so and refuses by name until those bytes are the
# qualified fixed-profile ones. Until it passes, no
# rsrcs/libdetcore_liteinst.package.json exists here and core
# verification refuses the layout; no receipt is fabricated to fill the
# gap. Landing order: the preload target below requires Reverie D1a
# (reverie-liteinst-preload) -- a direct fbcode dep in fbsource, and on
# the GitHub side D1a landed plus the export pin flow.
buck_genrule(
    name = "hermit-liteinst-install",
    out = "install",
    cmd = "mkdir -p $OUT/rsrcs"
    + " && cp $(location :hermit) $OUT/hermit"
    + " && cp $(location //hermetic_infra/hermit:detcore-liteinst-staged)/rsrcs/libdetcore_liteinst.so $OUT/rsrcs/libdetcore_liteinst.so"
    + " && cp $(location //hermetic_infra/hermit:detcore-liteinst-staged)/rsrcs/libdetcore_liteinst.package.json $OUT/rsrcs/libdetcore_liteinst.package.json"
    + " && cp $(location //hermetic_infra/reverie:reverie-liteinst-preload-stripped) $OUT/rsrcs/libreverie_liteinst.so"
    + " && cp $(location //hermetic_infra/hermit:reverie-liteinst-revision) $OUT/rsrcs/libreverie_liteinst.so.revision",
    # GATED OFF until D1c qualifies the Buck-built runtime bytes against
    # the fixed liteinst-runtime build: ci.skip_target() excludes this
    # target from Citadel/target-determinator selection (including the
    # hermit-linux-sanity-check rdeps build), and the contradictory
    # linux+macos target_compatible_with makes even an explicit
    # `buck2 build` report it incompatible/skipped instead of running the
    # finalizer genrule, which still refuses unqualified bytes by name.
    # D1c qualification is the unlocking event: remove both gates there.
    labels = [ci.skip_target()],
    target_compatible_with = [
        "ovr_config//cpu:x86_64",
        "ovr_config//os:linux",
        "ovr_config//os:macos",
    ],
)

# Cargo's src/bin/verification-report.rs; integration tests run it.
rust_binary(
    name = "verification-report",
    srcs = ["src/bin/verification-report.rs"],
    autocargo = {"ignore_rule": True},
    crate_root = "src/bin/verification-report.rs",
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    deps = [
        "fbsource//third-party/rust:serde_json",
        ":libhermit",
    ],
)

