# Records a guest and replays it under gdb (tests/record_with_gdb_smoke.test).
# Hermit does not pass on gdb's exit status, so the lit file checks gdb's own
# output: the breakpoint at main is set and hit, and the guest exits normally.
hermit_host_lit_test(
    name = "test_record_with_gdb_smoke",
    # RE workers have no gdb in PATH (measured 2026-10-28, re-cpuid RE pass).
    allow_cpuid_re = False,
    subs = [
        ("hermit", ":hermit"),
        ("gdb_smoke_guest", "//hermetic_infra/hermit/tests:gdb_smoke_guest"),
    ],
    test = "tests/record_with_gdb_smoke.test",
)

# The permanent x86-64-v2 regression test (tests/cpu_profile_v2_rootfs.rs):
# a libtest harness built as integration_tests.bzl builds Cargo's, run on a
# real host by hermit_host_test below. It is not (yet) an OSS validate DAG
# node, so it is declared by hand here, mirroring _integration_binary; when
# the DAG gains its node, generate.py owns this entry like the others.
rust_binary(
    name = "cpu-profile-v2-rootfs-test",
    autocargo = {"ignore_rule": True},
    crate = "cpu_profile_v2_rootfs",
    crate_root = "hermit-cli/tests/cpu_profile_v2_rootfs.rs",
    env = {
        # Cargo always sets this.
        "CARGO": "cargo",
        # Hermit isolates guest /tmp, so scratch space must not be under /tmp.
        "CARGO_TARGET_TMPDIR": "/var/tmp/hermit-v2-rootfs-test",
    },
    mapped_srcs = {
        src.removeprefix("hermit-cli/"): src
        for src in [
            "hermit-cli/tests/cpu_profile_v2_rootfs.rs",
            "hermit-cli/tests/common/hermit_binary.rs",
            "hermit-cli/tests/common/host_fact_v3.rs",
            "hermit-cli/tests/common/skid_overshoot.rs",
            "hermit-cli/tests/common/test_skip.rs",
            "hermit-cli/tests/fixtures/isa/cpuid_v2_probe.c",
            "hermit-cli/tests/fixtures/isa/needs_v3_lib.c",
            "hermit-cli/tests/fixtures/isa/undeclared_v3.c",
            "hermit-cli/tests/fixtures/isa/isa_needed.c",
        ]
    },
    rustc_flags = ["--test"],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    # The binary is already a libtest harness.
    unittests = False,
    deps = [
        "fbsource//third-party/rust:serde_json",
        "fbsource//third-party/rust:tar",
        "fbsource//third-party/rust:tempfile",
        "//hermetic_infra/hermit/detcore:detcore",
        "//hermetic_infra/hermit/detcore-model:detcore-model",
    ],
)

# The callable form of the x86-64-v3 host-fact refusal predicate for
# run_probed.py (fb-only/gated_tests): the shell-test runner asks this
# binary whether a failed command's exit status and stderr are a
# decided host-fact refusal, so host_fact_v3.rs stays the one
# classifier every runner shares. Buck-only, like
# cpu-profile-v2-rootfs-test above: no Cargo target names the file.
rust_binary(
    name = "host-fact-v3-verdict",
    autocargo = {"ignore_rule": True},
    crate = "host_fact_v3_verdict",
    crate_root = "hermit-cli/tests/common/host_fact_v3_verdict.rs",
    mapped_srcs = {
        src.removeprefix("hermit-cli/"): src
        for src in [
            "hermit-cli/tests/common/host_fact_v3_verdict.rs",
            "hermit-cli/tests/common/host_fact_v3.rs",
        ]
    },
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    # host_fact_v3.rs's unit tests run in the harnesses that include
    # hermit_binary.rs; this binary only exposes the predicate.
    unittests = False,
    # $(exe ...) for this binary is expanded by _host_admission in
    # every package that calls hermit_host_test.
    visibility = ["//hermetic_infra/hermit/..."],
    deps = [
        "//hermetic_infra/hermit/detcore-model:detcore-model",
    ],
)

# The v2 guest run on a v3-class host (admitted by hermit_host_test's
# x86-64-v3+cpuid-faulting probe, which is the point: the host being v3
# must not stop Hermit presenting v2 to a CentOS 9 guest). The fixture
# is fb-only/v2_rootfs's CentOS 9 glibc; REQUIRE makes a missing
# fixture a failure here, never a silent skip.
hermit_host_test(
    name = "test_cpu_profile_v2_rootfs",
    # The cases each start several Hermit guests; run them serially
    # so a small CI worker is not hosting a dozen ptrace guests at
    # once (the whole binary is seconds either way).
    args = ["--test-threads=1"],
    env = {
        "HERMIT_BIN": "$(exe_target :hermit)",
        "HERMIT_TEST_REQUIRE_V2_ROOTFS": "1",
        "HERMIT_TEST_V2_ROOTFS": "$(location //hermetic_infra/hermit/fb-only/v2_rootfs:glibc-fixture)",
    },
    test = ":cpu-profile-v2-rootfs-test",
)

