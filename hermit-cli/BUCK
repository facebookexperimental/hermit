rust_binary(
    name = "_hermit-release",
    srcs = glob(["src/bin/hermit/main.rs"]),
    crate = "hermit",
    env = release_build_env,
    link_style = "static_pic",
    rustc_flags = [
        "-C",
        "link-arg=-Wl,--disable-new-dtags",
        "-C",
        "link-arg=-Wl,-rpath,$ORIGIN/../install_pkg/rsrcs/hermit-runtime:$ORIGIN/install/rsrcs/hermit-runtime",
    ],
    # The guarded local producer overrides this with its content-bound prebuilt
    # target. CI resolves the default declared pkg-config dependency.
    deps = [release_lzma_target, release_unwind_target] + [
        ":_libhermit-release",
        "//common/rust/shed/fbinit:fbinit",
    ],
    **release_features
)

# The hermit-release aliases exist only in the GitHub build; see
# release_alias.bzl for why (fbcode forbids the raw configured_alias rule).
hermit_release_aliases()

buck_sh_test(
    name = "test_record_uptime",
    args = [
        "record",
        "start",
        "--verify",
        "--",
        "cat",
        "/proc/uptime",
    ],
    test = ":hermit",
)

buck_sh_test(
    name = "test_record_dev_urandom",
    args = [
        "record",
        "start",
        "--verify",
        "--",
        "hexdump",
        "-C",
        "-n",
        "32",
        "/dev/urandom",
    ],
    test = ":hermit",
)

buck_sh_test(
    name = "test_record_with_gdb_smoke",
    args = [
        "record",
        "start",
        "--verify-with-gdbex='b main; c; c'",
        "--",
        "hexdump",
        "-C",
        "-n",
        "32",
        "/dev/urandom",
    ],
    test = ":hermit",
)

