# libhermit's test harnesses take reverie-liteinst built against the one
# reverie-inguest of Cargo's hermit-cli test build
# (reverie:reverie-liteinst-exec-stop), beside their exec-stop dependency.
LIBHERMIT_TEST_DEPS = [
    "//hermetic_infra/reverie:reverie-liteinst-exec-stop" if dep == "//hermetic_infra/reverie:reverie-liteinst" else dep for dep in LIBHERMIT_DEPS
]

# libhermit's production dependencies: the shared list with
# reverie-liteinst built against the one reverie-inguest of Cargo's
# `exec-stop-launcher` build (reverie:reverie-liteinst-exec-stop-private),
# plus that feature's direct loader and digest dependencies. The inguest
# crate itself comes through named_deps, as in the test harnesses.
LIBHERMIT_PROD_DEPS = [dep for dep in LIBHERMIT_DEPS if dep != "//hermetic_infra/reverie:reverie-liteinst"] + [
    "fbsource//third-party/rust:sha2-010",
    "//hermetic_infra/reverie:reverie-liteinst-exec-stop-private",  # @manual name:reverie_liteinst
    "//hermetic_infra/reverie:reverie-loader",
]

