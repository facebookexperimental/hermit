load("@fbcode_macros//build_defs:export_files.bzl", "export_file")
load("@fbcode_macros//build_defs:native_rules.bzl", "buck_sh_test")
load("@fbsource//tools/build_defs:rust_binary.bzl", "rust_binary")
load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")
load(":release_alias.bzl", "hermit_release_aliases")

oncall("hermit")

hermit_build_env = {
    "CARGO_PKG_VERSION": "0.5.4",
    "HERMIT_BUILD_DATE": "unknown",
    "HERMIT_BUILD_GIT_SHA": "unknown",
    "HERMIT_REVERIE_PIN": "8ff253f159f587d0392d30c8b2323f1474adb746",
}

# The shadow release entrypoint supplies these values from Git/Cargo metadata
# using Buck config arguments (never shell-expanded source text). The supported
# entrypoint is `scripts/build-buck-release.rs`, which derives and validates all
# four values before selecting these shadow targets.
#
# Regular builds and CI (ci/buck-e2e, `validate --build buck-*`) instead pass
# -c hermit_release.unstamped=true: the same release feature set and linkage
# with the ordinary build identity (no commit hash, no build date), so a commit
# that changes no compiled source rebuilds nothing and stays cached. Without
# that flag the release targets still refuse to compile unstamped.
release_unstamped = read_root_config("hermit_release", "unstamped", "false") == "true"

# The release targets' cargo features, passed to both as their last argument,
# `**release_features`.
# A stamped build adds the buck-release-provenance cfg. Each case spells out its
# whole list because scripts/check-buck-reindeer-features.rs reads only literal
# `features` lists, never a variable or a concatenation.
release_features = {"features": [
    "liteinst",
]} if release_unstamped else {"features": [
    "buck-release-provenance",
    "liteinst",
]}
release_build_env = hermit_build_env if release_unstamped else {
    "CARGO_PKG_VERSION": read_root_config("hermit_release", "version", ""),
    "HERMIT_BUILD_DATE": read_root_config("hermit_release", "build_date", ""),
    "HERMIT_BUILD_GIT_SHA": read_root_config("hermit_release", "hermit_sha", ""),
    "HERMIT_REVERIE_PIN": read_root_config("hermit_release", "reverie_sha", ""),
}
release_lzma_target = read_root_config(
    "hermit_release",
    "lzma_target",
    "fbsource//third-party/xz:lzma",
)
release_unwind_target = read_root_config(
    "hermit_release",
    "unwind_target",
    "fbsource//third-party/libunwind:unwind-ptrace",
)

rust_library(
    name = "libhermit",
    autocargo = {
        "cargo_toml_dir": ".",
        "cargo_toml_config": {
            "package": {
                "name": "hermit-run",
                "version": "0.5.4",
                "readme": "README.md",
                "homepage": "https://hermetic-infra.org",
                "documentation": "https://docs.rs/hermit-run",
                "keywords": [
                    "linux",
                    "hermit",
                    "determinism",
                    "debugging"
                ],
                "categories": [
                    "development-tools::debugging",
                    "development-tools::testing"
                ],
                "metadata": {"hermit": {"build-identity": "source"}},
            },
            "dependencies_override": {
                "dependencies": {
                    "reverie-inguest": {"default-features": False, "optional": True},
                    "sha2": {"optional": True},
                    "reverie-rpc-transport": {"optional": True},
                },
                "build-dependencies": {
                    "libc": {"version": "0.2.186"},
                    "sha1_smol": {"version": "1.0.1"},
                    "serde": {"version": "1.0.219", "features": ["derive"]},
                    "serde_json": {"version": "1.0.140"},
                    "sha2": {"version": "0.10.9"},
                    "toml": {"version": "0.8.23"},
                },
                "dev-dependencies": {
                    # Export debt: Cargo makes this test dependency x86_64-only.
                    # This override is not target-synchronized; see the Cargo/Buck
                    # coverage note in docs/TESTING_ENVIRONMENTS.md.
                    "reverie-inguest": {"default-features": False, "features": ["exec-stop"]},
                    "toml": {"version": "0.8.23"},
                },
            },
            "features": {
                "exec-stop-launcher": ["dep:reverie-inguest", "reverie-inguest/exec-stop", "reverie-inguest/loader-private-runtime"],
                "default": [],
                "loader-rcb-observation": ["exec-stop-launcher", "reverie-ptrace/rcb-observation"],
                "liteinst": ["dep:reverie-liteinst", "dep:reverie-rpc-transport"],
                "native-exec-input-admission": [],
                "native-exec": ["native-exec-input-admission", "liteinst", "detcore-model/native-exec", "reverie-liteinst/exec-native-injection", "dep:reverie-inguest", "dep:sha2"],
                "kvm-native-test-support": ["reverie-kvm/native-test-support"],
                "mm-cancellation-test-support": ["exec-stop-launcher", "liteinst", "detcore/physical-mm-test-support"],
                "kvm-execution-tests": [],
            },
        },
    },
    srcs = glob(
        [
            "src/**/*.rs",
            "README.md",
        ],
        exclude = [
            "src/bin/**/*.rs",
        ],
    ) + glob(
        ["src/bin/hermit/**/*.rs"],
        exclude = ["src/bin/hermit/main.rs"],
    ),
    test_srcs = glob([
        "src/bin/**/*.rs",
        "test-resources/**/*.json",
        "tests/common/exclusive_rewrite_summary.rs",
        "tests/common/readonly_proc.rs",
        "tests/fixtures/staged-summary.gitignore",
    ]),
    crate = "hermit",
    env = hermit_build_env,
    # Like _libhermit-release below: the LiteInst backing descriptor and the
    # in-guest entry symbols are per-image link contracts that only a final
    # binary link can resolve, so this library must not become a shared object.
    preferred_linkage = "static",
    # The shared application deliberately uses LiteInst in this internal debug
    # build, unlike Cargo's empty default feature set. Backend cfgs and their app
    # tests now belong to this library, not the thin executable.
    features = ["liteinst"],
    # iced-x86 decoder tables are process-lifetime globals.
    test_env = {"LSAN_OPTIONS": "detect_leaks=0"},
    deps = [
        "fbsource//third-party/rust:addr2line",
        "fbsource//third-party/rust:anyhow",
        "fbsource//third-party/rust:bincode",
        "fbsource//third-party/rust:clap",
        "fbsource//third-party/rust:dirs",
        "fbsource//third-party/rust:goblin",
        "fbsource//third-party/rust:iced-x86",
        "fbsource//third-party/rust:libc",
        "fbsource//third-party/rust:nix",
        "fbsource//third-party/rust:object",
        "fbsource//third-party/rust:rand_pcg",
        "fbsource//third-party/rust:serde",
        "fbsource//third-party/rust:serde_json",
        "fbsource//third-party/rust:tempfile",
        "fbsource//third-party/rust:tokio",
        "fbsource//third-party/rust:tracing",
        "fbsource//third-party/rust:tracing-log",
        "fbsource//third-party/rust:tracing-subscriber",
        "fbsource//third-party/rust:uuid",
        "//hermetic_infra/hermit/detcore:detcore",
        "//hermetic_infra/hermit/detcore-model:detcore-model",
        "//hermetic_infra/hermit/hermit-record:hermit-record",
        "//hermetic_infra/hermit/hermit-record-format:hermit-record-format",
        "//hermetic_infra/hermit/hermit-replay:hermit-replay",
        "//hermetic_infra/hermit/hermit-run-kvm:hermit-run-kvm",
        "//hermetic_infra/hermit/hermit-run-ptrace:hermit-run-ptrace",
        "//hermetic_infra/hermit/hermit-resources:hermit-resources",
        "//hermetic_infra/reverie:reverie",
        "fbsource//third-party/rust:flate2",
        "fbsource//third-party/rust:tar",
        "//hermetic_infra/reverie:reverie-kvm",
        "//hermetic_infra/reverie:reverie-liteinst",
        "//hermetic_infra/reverie:reverie-ptrace",
