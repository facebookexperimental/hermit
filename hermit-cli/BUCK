rust_binary(
    name = "hermit",
    autocargo = {
        "cargo_toml_dir": ".",
        "cargo_toml_config": {
            "package": {
                "name": "hermit-run",
                "version": "0.5.4",
                "readme": "README.md",
                "homepage": "https://hermetic-infra.org",
                "documentation": "https://docs.rs/hermit-run",
                "keywords": [
                    "linux",
                    "hermit",
                    "determinism",
                    "debugging"
                ],
                "categories": [
                    "development-tools::debugging",
                    "development-tools::testing"
                ],
                "metadata": {"hermit": {"build-identity": "source"}},
            },
            "dependencies_override": {
                "dependencies": {
                    "reverie-inguest": {"default-features": False, "optional": True},
                    "sha2": {"optional": True},
                    "reverie-rpc-transport": {"optional": True},
                },
                "build-dependencies": {
                    "toml": {"version": "0.8.23"},
                },
                "dev-dependencies": {
                    # Export debt: Cargo makes this test dependency x86_64-only.
                    # This override is not target-synchronized; see the Cargo/Buck
                    # coverage note in docs/TESTING_ENVIRONMENTS.md.
                    "reverie-inguest": {"default-features": False, "features": ["exec-stop"]},
                    "toml": {"version": "0.8.23"},
                },
            },
            "features": {
                "exec-stop-launcher": ["dep:reverie-inguest", "reverie-inguest/exec-stop", "reverie-inguest/loader-private-runtime"],
                "default": [],
                "loader-rcb-observation": ["exec-stop-launcher", "reverie-ptrace/rcb-observation"],
                "liteinst": ["dep:reverie-liteinst", "dep:reverie-rpc-transport"],
                "native-exec-input-admission": [],
                "native-exec": ["native-exec-input-admission", "liteinst", "detcore-model/native-exec", "reverie-liteinst/exec-native-injection", "dep:reverie-inguest", "dep:sha2"],
                "kvm-native-test-support": ["reverie-kvm/native-test-support"],
                "mm-cancellation-test-support": ["exec-stop-launcher", "liteinst", "detcore/physical-mm-test-support"],
                "kvm-execution-tests": [],
            },
        },
    },
    srcs = glob(["src/bin/hermit/main.rs"]),
    env = hermit_build_env,
    # Backend cfgs are owned by :libhermit. This thin entry contains only
    # executable preinitialization and fbinit, so it needs no backend feature list.
    # Signal-handler messages intentionally live for the process lifetime.
    test_env = {"LSAN_OPTIONS": "detect_leaks=0"},
    test_srcs = glob(["src/bin/hermit/main.rs"]),
    deps = [
        ":libhermit",
        "//common/rust/shed/fbinit:fbinit",
    ],
)

