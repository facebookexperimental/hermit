# Inputs of fb-only/integration_tests/generate.py, checked for drift by its test.
buck_filegroup(
    name = "integration-generator-inputs",
    # integration_tests_data.bzl, the one *_data.bzl, is fbsource's own
    # generated file: the open-source tree does not carry it, so the glob
    # names it without requiring it, and the target is fbsource-only.
    srcs = [
        "build.rs",
        "build_support.rs",
        "reverie_pin.rs",
    ]
    + glob(["*_data.bzl", "src/**", "tests/**"]),
    target_compatible_with = ["fbcode//opensource/macros:broken-in-oss"],
    visibility = [
        "//hermetic_infra/hermit/fb-only/integration_tests/tests:",
        "//hermetic_infra/hermit/fb-only/rr_tests/tests:",
    ],
)

hermit_host_test(
    name = "test_record_uptime",
    args = [
        "record",
        "start",
        "--verify",
        "--",
        "cat",
        "/proc/uptime",
    ],
    test = ":hermit",
)

hermit_host_test(
    name = "test_record_dev_urandom",
    args = [
        "record",
        "start",
        "--verify",
        "--",
        "hexdump",
        "-C",
        "-n",
        "32",
        "/dev/urandom",
    ],
    test = ":hermit",
)

hermit_host_test(
    name = "test_record_with_gdb_smoke",
    # RE workers have no gdb in PATH (measured 2026-10-28, re-cpuid RE pass).
    allow_cpuid_re = False,
    args = [
        "record",
        "start",
        "--verify-with-gdbex='b main; c; c'",
        "--",
        "hexdump",
        "-C",
        "-n",
        "32",
        "/dev/urandom",
    ],
    test = ":hermit",
)

