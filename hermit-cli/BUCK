load("@fbcode_macros//build_defs:native_rules.bzl", "buck_sh_test")
load("@fbsource//tools/build_defs:rust_binary.bzl", "rust_binary")
load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("hermit")

hermit_build_env = {
    "CARGO_PKG_VERSION": "0.4.1",
    "HERMIT_BUILD_DATE": "unknown",
    "HERMIT_BUILD_GIT_SHA": "unknown",
    "HERMIT_REVERIE_PIN": "e39c780fd2d48424f3f7389330d22689526856fa",
}

# The shadow release entrypoint supplies these values from Git/Cargo metadata
# using Buck config arguments (never shell-expanded source text). The supported
# entrypoint is `scripts/build-buck-release.rs`, which derives and validates all
# four values before selecting these shadow targets.
#
# Regular builds and CI (ci/buck-e2e, `validate --build buck-*`) instead pass
# -c hermit_release.unstamped=true: the same release feature set and linkage
# with the ordinary build identity (no commit hash, no build date), so a commit
# that changes no compiled source rebuilds nothing and stays cached. Without
# that flag the release targets still refuse to compile unstamped.
release_unstamped = read_root_config("hermit_release", "unstamped", "false") == "true"

# The release targets' cargo features, passed to both as their last argument,
# `**release_features`.
# A stamped build adds the buck-release-provenance cfg. Each case spells out its
# whole list because scripts/check-buck-reindeer-features.rs reads only literal
# `features` lists, never a variable or a concatenation.
release_features = {"features": [
    "dbt",
    "e9patch",
    "liteinst",
    "sabre",
]} if release_unstamped else {"features": [
    "buck-release-provenance",
    "dbt",
    "e9patch",
    "liteinst",
    "sabre",
]}
release_build_env = hermit_build_env if release_unstamped else {
    "CARGO_PKG_VERSION": read_root_config("hermit_release", "version", ""),
    "HERMIT_BUILD_DATE": read_root_config("hermit_release", "build_date", ""),
    "HERMIT_BUILD_GIT_SHA": read_root_config("hermit_release", "hermit_sha", ""),
    "HERMIT_REVERIE_PIN": read_root_config("hermit_release", "reverie_sha", ""),
}
release_lzma_target = read_root_config(
    "hermit_release",
    "lzma_target",
    "gh_facebook_buck2_shims_meta//third-party/xz:lzma",
)
release_unwind_target = read_root_config(
    "hermit_release",
    "unwind_target",
    "gh_facebook_buck2_shims_meta//third-party/libunwind:unwind-ptrace",
)

