# libhermit's test harnesses take reverie-liteinst built against the one
# reverie-inguest of Cargo's hermit-cli test build
# (reverie:reverie-liteinst-exec-stop), beside their exec-stop dependency.
LIBHERMIT_TEST_DEPS = [
    "//hermetic_infra/reverie:reverie-liteinst-exec-stop" if dep == "//hermetic_infra/reverie:reverie-liteinst" else dep for dep in LIBHERMIT_DEPS
]

LIBHERMIT_ENV = {
    # src/bin/hermit/version.rs reports it in `hermit --version`. Keep in sync
    # with the version in oss_cargo/hermit-cli/Cargo.toml.oss.
    "CARGO_PKG_VERSION": "0.5.6",
    # The open-source Buck build's version string names these (an fbcode
    # build reports BuildInfo instead); a regular build embeds no date or
    # revision.
    "HERMIT_BUILD_DATE": "unknown",
    "HERMIT_BUILD_GIT_SHA": "unknown",
    "HERMIT_REVERIE_PIN": "820b48394596cac8f9a496c61d681aa83650b1eb",
}

# The unit tests' run-time environment.
LIBHERMIT_TEST_RUN_ENV = {
    "CARGO_MANIFEST_DIR": "$(location :hermit-test-fixtures)",
    # iced-x86 decoder tables and signal-handler messages are process-lifetime
    # globals.
    "LSAN_OPTIONS": "detect_leaks=0",
    "RUST_MIN_STACK": "16777216",
}

# libhermit's sources as its test harnesses see them, under a "hermit-cli/"
# prefix: src/bin/hermit/mod.rs's unit tests include detcore-liteinst's
# numeric mapped-entry bounds by #[path], which must resolve inside the
# declared source tree.
LIBHERMIT_TEST_SRCS = {
    src: "hermit-cli/" + src
    for src in [
        "README.md",
        "reverie_pin.rs",
        "src/in_guest_delivery_harness/guest.c",
        "tests/common/exclusive_rewrite_summary.rs",
        "tests/common/readonly_proc.rs",
        "tests/fixtures/chosen-before-reserved-input.json",
        "tests/fixtures/ptrace_copy_permission.c",
        "tests/fixtures/random_copy_fatal.c",
    ]
    + glob([
        "test-resources/**/*.json",
        "tests/fixtures/access_trace_*.jsonl",
        "tests/fixtures/dbt/*.json",
    ])
    + glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/*.rs"],
    )
} | {
    "//hermetic_infra/hermit:mapped-entry-bounds": "detcore-liteinst/src/exec_initial/mapped_entry/bounds.rs",
}

# libhermit's sources, shared with :_libhermit-release.
LIBHERMIT_SRCS = [
    # src/lib.rs's crate documentation.
    "README.md",
] + glob(
    [
        "src/**/*.rs",
    ],
    # src/lib.rs includes the application, src/bin/hermit/mod.rs, as `app`;
    # the other binaries stay out.
    exclude = [
        "src/bin/*.rs",
    ],
)

rust_library(
    name = "libhermit",
    srcs = LIBHERMIT_SRCS,
    autocargo = {
        "cargo_toml_config": {
            "dependencies_override": {
                "dev-dependencies": {
                    "reverie-inguest": {
                        "default-features": False,
                        "features": ["exec-stop"],
                    },
                },
            },
            # Retain the package's Cargo dependency surface independently of
            # the native default-feature binary's narrower dependency graph.
            "extra_buck_dependencies": {
                "dependencies": [
                    ("hermit-test-workdir", "//hermetic_infra/hermit/common/test-workdir:hermit-test-workdir"),
                    ("num_cpus", "fbsource//third-party/rust:num_cpus"),
                ],
                # Cargo-only: upstream's tests/*.rs integration tests, which Buck does not build.
                "dev-dependencies": [
                    ("proc-macro2", "fbsource//third-party/rust:proc-macro2"),
                    ("quote", "fbsource//third-party/rust:quote"),
                    ("reverie-inguest", "//hermetic_infra/reverie:reverie-inguest"),
                    ("reverie-loader", "//hermetic_infra/reverie:reverie-loader"),
                    ("ruzstd", "fbsource//third-party/rust:ruzstd"),
                    ("sha2", "fbsource//third-party/rust:sha2-010"),
                    ("syn", "fbsource//third-party/rust:syn2"),
                ],
            },
            # The OSS package's backend features (oss_cargo/hermit-cli/
            # Cargo.toml.oss), declared but empty, which keeps
            # `cfg(feature = ...)` known to clippy's `-D warnings` in
            # fb-only/ci.sh. Of those backends fbsource builds only LiteInst,
            # whose dependencies the Buck targets list unconditionally.
            "features": {
                "dbt": [],
                "default": [],
                "e9patch": [],
                "exec-stop-launcher": [],
                "kvm-execution-tests": [],
                "kvm-native-test-support": [],
                "liteinst": [],
                "native-exec": [],
                "sabre": [],
                "third-party-backends": [
                    "dbt",
                    "e9patch",
                    "liteinst",
                    "sabre",
                ],
            },
            "package": {"name": "hermit-run"},
            # Preserve upstream's explicit feature requirements for these
            # integration tests; Cargo must not select them without LiteInst.
            "test": [
                {
                    "name": "liteinst_allocator",
                    "required-features": ["liteinst"],
                },
                {
                    "name": "liteinst_stacks",
                    "required-features": ["liteinst"],
                },
            ],
        },
    },
    crate = "hermit",
    env = LIBHERMIT_ENV,
    # The LiteInst backend, as upstream's Buck build of this library. Each
    # target spells out its features: the open-source tree's
    # scripts/check-buck-reindeer-features.rs reads only literal lists.
    features = ["liteinst"],
    named_deps = {"reverie": "//hermetic_infra/reverie:reverie"},
    # The LiteInst backing descriptor and the in-guest entry symbols are
    # per-image link contracts that only a final binary link can resolve, so
    # this library must not become a shared object.
    preferred_linkage = "static",
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    # :libhermit-unittest below, which needs the prefixed source layout.
    unittests = False,
    deps = LIBHERMIT_DEPS,
)

# libhermit's unit tests, the application's (src/bin/hermit) included.
rust_unittest(
    name = "libhermit-unittest",
    # The system allocator, as in the Cargo build and as :hermit uses.
    # fbcode's default jemalloc runs background threads (jemalloc_bg_thd), and
    # a test that clones a container refuses to while any thread but libtest's
    # main thread runs beside it (src/bin/hermit/test_isolation.rs).
    allocator = "malloc",
    autocargo = {"ignore_rule": True},
    crate = "hermit",
    crate_root = "hermit-cli/src/lib.rs",
    env = LIBHERMIT_ENV,
    features = ["liteinst"],
    # Run by :libhermit-unittest-gated (fb-only/gated_tests).
    labels = run_gated_only(),
    mapped_srcs = LIBHERMIT_TEST_SRCS,
    named_deps = {
        "reverie": "//hermetic_infra/reverie:reverie",
        # Cargo's dev-dependency on reverie-inguest with `exec-stop`, for
        # src/bin/hermit/exec_stop_launch_tests.rs.
        "reverie_inguest": "//hermetic_infra/reverie:reverie-inguest-exec-stop",
    },
    resources = [":hermit-test-fixtures"],
    run_env = LIBHERMIT_TEST_RUN_ENV,
    # The test fixtures are project-relative, as Cargo's CARGO_MANIFEST_DIR.
    rustc_flags = [
        "--env-set=CARGO_MANIFEST_DIR=$(location :hermit-test-fixtures)",
    ],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    deps = LIBHERMIT_TEST_DEPS,
)

# libhermit's unit-test harness with upstream's test-only `kvm-execution-tests`
# feature, which adds src/kvm_execution_tests.rs and nothing else. It is not a
# test target itself: privileged-test.cli_kvm (integration_tests.bzl) selects
# from it, so the ordinary unit tests never require KVM.
rust_binary(
    name = "integration-libhermit-kvm",
    # The system allocator, for the reason given at :libhermit-unittest.
    allocator = "malloc",
    autocargo = {"ignore_rule": True},
    crate = "hermit",
    crate_root = "hermit-cli/src/lib.rs",
    env = LIBHERMIT_ENV,
    features = [
        "liteinst",
        "kvm-execution-tests",
    ],
    mapped_srcs = LIBHERMIT_TEST_SRCS,
    named_deps = {
        "reverie": "//hermetic_infra/reverie:reverie",
        "reverie_inguest": "//hermetic_infra/reverie:reverie-inguest-exec-stop",
    },
    rustc_flags = ["--test"],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    # The binary is already a libtest harness.
    unittests = False,
    deps = LIBHERMIT_TEST_DEPS,
)

rust_binary(
    name = "hermit",
    srcs = ["src/bin/hermit/main.rs"],
    # The system allocator, as in the Cargo build. fbcode's default jemalloc
    # starts a background thread before main(), which breaks the CLI-owned
    # lifecycle role's single-threaded precondition (cli_owned_lifecycle.rs).
    allocator = "malloc",
    autocargo = {
        "cargo_target_config": {"path": "src/bin/hermit/main.rs"},
    },
    crate_root = "src/bin/hermit/main.rs",
    link_group_map = [],
    link_style = "static_pic",
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    # main.rs only starts libhermit's application (hermit::app), whose unit
    # tests are :libhermit-unittest.
    unittests = False,
    deps = [
        ":libhermit",
        "//common/rust/shed/fbinit:fbinit",
    ],
)

# libhermit and hermit as the release build compiles them, :_libhermit-release
# and :_hermit-release (release_alias.bzl). The open-source build selects them
# as :libhermit-release and :hermit-release.
hermit_release_targets(
    srcs = LIBHERMIT_SRCS,
    unstamped_env = LIBHERMIT_ENV,
    deps = LIBHERMIT_DEPS,
)

# The hermit-release aliases exist only in the open-source build; see
# release_alias.bzl for why (fbcode forbids the raw configured_alias rule).
hermit_release_aliases()

gated_test(
    name = "libhermit-unittest-gated",
    env = LIBHERMIT_TEST_RUN_ENV,
    # Match the native Rust test provider: fixtures are project-relative.
    labels = ["buck2_run_from_project_root"],
    test = "//hermetic_infra/hermit/hermit-cli:libhermit-unittest",
)

# Cargo's src/bin/hermit-dap.rs; the CLI integration tests run it.
rust_binary(
    name = "hermit-dap",
    srcs = [
        "src/bin/hermit-dap.rs",
        "src/bin/hermit-dap-reverse.py",
    ],
    autocargo = {"ignore_rule": True},
    crate_root = "src/bin/hermit-dap.rs",
    # Match :hermit above: a self-contained link, so the staged copy beside
    # :hermit (hermit-and-hermit-dap) does not depend on shared libraries
    # the copy does not carry. Without this the staged hermit-dap fails in
    # the dynamic loader (libunwind.so.8) before it can run.
    link_group_map = [],
    link_style = "static_pic",
    deps = [
        "fbsource//third-party/rust:libc",
        "fbsource//third-party/rust:nix",
        "fbsource//third-party/rust:serde_json",
    ],
)

# hermit and hermit-dap copied into one directory, as Cargo builds them. Each
# starts the other from beside its own executable, which a link to either
# output cannot provide. The CLI integration tests stage both from here.
buck_genrule(
    name = "hermit-and-hermit-dap",
    out = "bin",
    cmd = "mkdir -p $OUT && cp $(location :hermit) $OUT/hermit && cp $(location :hermit-dap) $OUT/hermit-dap",
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

# Cargo's src/bin/verification-report.rs; integration tests run it.
rust_binary(
    name = "verification-report",
    srcs = ["src/bin/verification-report.rs"],
    autocargo = {"ignore_rule": True},
    crate_root = "src/bin/verification-report.rs",
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    deps = [
        "fbsource//third-party/rust:serde_json",
        ":libhermit",
    ],
)

buck_filegroup(
    name = "hermit-test-fixtures",
    srcs = {src: src for src in glob(["test-resources/**/*.json"])},
)

# hermit-cli as its Cargo integration tests see CARGO_MANIFEST_DIR at run time
# (part of //hermetic_infra/hermit:integration-repository).
buck_filegroup(
    name = "integration-cli-tree",
    srcs = glob(["**"], exclude = ["BUCK", "*.bzl"]),
    visibility = ["//hermetic_infra/hermit:"],
)

