load("@fbcode_macros//build_defs:cpp_unittest.bzl", "cpp_unittest")
load("@fbcode_macros//build_defs:export_files.bzl", "buck_export_file")
load("@fbcode_macros//build_defs:native_rules.bzl", "buck_sh_test")
load("@fbsource//tools/build_defs:rust_binary.bzl", "rust_binary")
load("@fbsource//tools/build_defs:testpilot_defs.bzl", "tpx_labels")
load("@fbsource//tools/build_defs/testinfra:network_access_utils.bzl", "network_access_utils")

oncall("hermit")

cpp_unittest(
    name = "bind_same",
    srcs = [
        "bind/bind_same.cpp",
    ],
    args = ["--gtest_catch_exceptions=1"],
    labels = [tpx_labels.local_only],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    deps = ["fbsource//third-party/googletest:gtest"],
)

cpp_unittest(
    name = "bind_random",
    srcs = [
        "bind/bind_random.cpp",
    ],
    args = ["--gtest_catch_exceptions=1"],
    labels = [tpx_labels.local_only],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only. The
    # open-source Buck build carries no folly.
    target_compatible_with = [
        "fbcode//opensource/macros:broken-in-oss",
        "ovr_config//cpu:x86_64",
    ],
    deps = [
        "fbsource//third-party/googletest:gtest",
        "fbsource//xplat/folly:random",
    ],
)

rust_binary(
    name = "cas_sequence_easy_bin",
    srcs = ["cas_sequence_easy.rs"],
    crate_root = "cas_sequence_easy.rs",
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

buck_sh_test(
    name = "run_hello_race",
    args = [],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
