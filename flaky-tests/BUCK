buck_sh_test(
    name = "run_flaky_cas_sequence",
    args = [],
    # A deliberately flaky fixture ("Antagonistic schedule reached, failing")
    # for exercising Hermit's flakiness tooling, not a test that should pass
    # natively; keep it out of CI.
    labels = [tpx_labels.local_only],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    test = ":cas_sequence_easy_bin",
)

buck_sh_test(
    name = "run_flaky_nanosleep-threads-simple",
    args = [],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    test = "//hermetic_infra/hermit/tests:nanosleep-threads-simple",
)

cpp_unittest(
    name = "use_configurable_flaky_service",
    srcs = [
        "use_configurable_flaky_service.cpp",
    ],
    # A deliberately flaky fixture: the remote service fails on purpose and the
    # client crashes on large errors. Keep it out of CI.
    labels = [tpx_labels.local_only],
    network_access = network_access_utils.all(),
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only. The
    # open-source Buck build's shim has no curl.
    target_compatible_with = [
        "fbcode//opensource/macros:broken-in-oss",
        "ovr_config//cpu:x86_64",
    ],
    deps = [
        "fbsource//third-party/fmt:fmt",
        "fbsource//third-party/googletest:gtest",
    ],
    external_deps = [
        "curl",
    ],
)

buck_sh_test(
    name = "flaky_server_test",
    args = [
        "$(location //hermetic_infra/hermit/hermit-cli:hermit)",
        "1",
    ],
    # A deliberately flaky fixture: flaky_server.sh answers with a random 0/1
    # that becomes this test's exit code. Keep it out of CI.
    labels = [tpx_labels.local_only],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    test = "external_flaky_service/flaky_server_test.sh",
)

# This package's Cargo manifest, for the tree check.backend_abstraction runs
# on (//hermetic_infra/hermit:backend-abstraction-repository).
buck_export_file(
    name = "Cargo.toml",
    visibility = ["//hermetic_infra/hermit:"],
)

# stress_suite.rs compiles this guest at run time from the integration tests'
# repository (//hermetic_infra/hermit:integration-repository).
buck_export_file(
    name = "cas_sequence_easy.rs",
    visibility = ["//hermetic_infra/hermit:"],
)
