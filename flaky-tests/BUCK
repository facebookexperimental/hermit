load("@fbcode//hermetic_infra/hermit/fb-only/gated_tests:defs.bzl", "hermit_host_test")
load("@fbcode_macros//build_defs:cpp_unittest.bzl", "cpp_unittest")
load("@fbcode_macros//build_defs:export_files.bzl", "buck_export_file")
load("@fbcode_macros//build_defs:native_rules.bzl", "buck_sh_test")
load("@fbsource//tools/build_defs:rust_binary.bzl", "rust_binary")
load("@fbsource//tools/build_defs:testpilot_defs.bzl", "tpx_labels")

oncall("hermit")

cpp_unittest(
    name = "bind_same",
    srcs = [
        "bind/bind_same.cpp",
    ],
    args = ["--gtest_catch_exceptions=1"],
    labels = [tpx_labels.local_only],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    deps = ["fbsource//third-party/googletest:gtest"],
)

cpp_unittest(
    name = "bind_random",
    srcs = [
        "bind/bind_random.cpp",
    ],
    args = ["--gtest_catch_exceptions=1"],
    labels = [tpx_labels.local_only],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only. The
    # open-source Buck build carries no folly.
    target_compatible_with = [
        "fbcode//opensource/macros:broken-in-oss",
        "ovr_config//cpu:x86_64",
    ],
    deps = [
        "fbsource//third-party/googletest:gtest",
        "fbsource//xplat/folly:random",
    ],
)

rust_binary(
    name = "cas_sequence_easy_bin",
    srcs = ["cas_sequence_easy.rs"],
    crate_root = "cas_sequence_easy.rs",
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

# The hello_race guest is deliberately racy natively (it exits 1 on the
# antagonistic schedule); this target instead runs it under Hermit
# chaos-verify and passes only on Hermit's determinism verdict, mirroring
# hermit_modes::hello_race_chaos_verify. Remove local_only after a
# passing HEAD run in fbcode//mode/dev-nosan; then check the target's
# first continuous coverage-mode run.
hermit_host_test(
    name = "run_hello_race",
    args = [
        "$(location //hermetic_infra/hermit/hermit-cli:hermit)",
        "$(location :hello_race)",
    ],
    labels = [tpx_labels.local_only],
    test = "run_hello_race_hermit.sh",
)

rust_binary(
    name = "hello_race",
    srcs = ["hello_race.rs"],
    allocator = "malloc",
    crate_root = "hello_race.rs",
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    # Retired by name: hello_race-unittest. Its #[test] body exits the
    # process from inside the test on the antagonistic schedule, and
    # run_hello_race above already runs this same source and run_test() body
    # deterministically under Hermit, so the native form adds no
    # coverage. Recorded here so the retirement is not a silent delete.
    unittests = False,
)

rust_binary(
    name = "hello_race_mini",
    srcs = ["hello_race_mini.rs"],
    allocator = "malloc",
    crate_root = "hello_race_mini.rs",
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    # Retired by name: hello_race_mini-unittest. The source has no
    # #[test] at all, so the implicit unittest target was vacuous; its
    # coverage moved to run_hello_race_mini below, which runs this
    # same binary deterministically under Hermit. Recorded here so
    # the retirement is not a silent delete.
    unittests = False,
)

# The hello_race_mini guest is the simplest store race (it exits 1 on
# the antagonistic schedule); this target runs it under Hermit
# chaos-verify and passes only on Hermit's determinism verdict, the
# same shape as run_hello_race. Keep local_only until a passing
# HEAD run in fbcode//mode/dev-nosan; then check the first continuous
# coverage-mode run.
hermit_host_test(
    name = "run_hello_race_mini",
    args = [
        "$(location //hermetic_infra/hermit/hermit-cli:hermit)",
        "$(location :hello_race_mini)",
        "$(location //hermetic_infra/hermit/tests:e2e_defaults_yaml)",
    ],
    labels = [tpx_labels.local_only],
    test = "run_hello_race_mini_hermit.sh",
)

# The cas_sequence_easy guest completes its CAS handoff (and exits 1)
# only under one interleaving; this target instead runs it under Hermit
# chaos-verify over an ordered seed search and passes only on bitwise
# parity at every tried seed plus both guest outcomes. Remove local_only
# after a passing HEAD run in fbcode//mode/dev-nosan; then check the
# target's first continuous coverage-mode run.
hermit_host_test(
    name = "run_flaky_cas_sequence",
    args = [
        "$(location //hermetic_infra/hermit/hermit-cli:hermit)",
        "$(location :cas_sequence_easy_bin)",
    ],
    # The ordered seed search's worst legitimate wall is the full
    # 32-seed range at the measured per-seed wall (at most 32.4s,
    # about 1,036s; CPU at most 15.6s per seed). Multiplier 3 sizes
    # the runner timeout to about 1,800s for that range; the wrapper's
    # own 1,500s total budget fails by name well inside it.
    labels = [
        tpx_labels.local_only,
        "tpx:timeout-multiplier:3",
    ],
    test = "run_flaky_cas_sequence_hermit.sh",
)

buck_sh_test(
    name = "run_flaky_nanosleep-threads-simple",
    args = [],
    # A deliberately racy fixture: the child thread may null the pointer the
    # main thread then writes through, which crashes on that schedule; keep it
    # out of CI.
    labels = [tpx_labels.local_only],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    test = "//hermetic_infra/hermit/tests:nanosleep-threads-simple",
)

# The original host-side harness, restored unchanged under a native
# name until its retirement is approved after the wired proof: the
# same buck_sh_test this package shipped as flaky_server_test.
buck_sh_test(
    name = "flaky_server_native_test",
    args = [
        "$(location //hermetic_infra/hermit/hermit-cli:hermit)",
        "1",
    ],
    # A deliberately flaky fixture: flaky_server.sh answers with a random 0/1
    # that becomes this test's exit code. Keep it out of CI.
    labels = [tpx_labels.local_only],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    test = "external_flaky_service/flaky_server_test.sh",
)

# The original server script, staged for the in-guest driver below.
buck_export_file(
    name = "external_flaky_service/flaky_server.sh",
    visibility = ["//hermetic_infra/hermit/flaky-tests:"],
)

buck_export_file(
    name = "flaky_server_guest.sh",
    visibility = ["//hermetic_infra/hermit/flaky-tests:"],
)

# flaky_server.sh answers each request with a bash RANDOM bit; the old
# host-side test made one draw its exit code over a host port. This
# target instead runs the unmodified server as a multi-process guest
# (flaky_server_guest.sh starts it, makes the requests in order, and
# cleans up exactly what it started) under Hermit strict verify, and
# passes only on bitwise parity plus the protocol property: exactly
# the requested replies, each 0 or 1, in request order. No
# network_access is declared, because a target that never reaches
# the network (the guest loopback only, --network=local) is not
# labelled as though it did. The host-side flaky_server_test.sh
# stays until the wired proof lands and its retirement is approved.
# Keep local_only until a passing HEAD run in
# fbcode//mode/dev-nosan; then check the first continuous
# coverage-mode run.
hermit_host_test(
    name = "flaky_server_test",
    args = [
        "$(location //hermetic_infra/hermit/hermit-cli:hermit)",
        "$(location :flaky_server_guest.sh)",
        "$(location :external_flaky_service/flaky_server.sh)",
        "8",
        "18080",
    ],
    labels = [tpx_labels.local_only],
    test = "run_flaky_server_hermit.sh",
)

# This package's Cargo manifest, for the tree check.backend_abstraction runs
# on (//hermetic_infra/hermit:backend-abstraction-repository).
buck_export_file(
    name = "Cargo.toml",
    visibility = ["//hermetic_infra/hermit:"],
)

# stress_suite.rs compiles this guest at run time from the integration tests'
# repository (//hermetic_infra/hermit:integration-repository).
buck_export_file(
    name = "cas_sequence_easy.rs",
    visibility = ["//hermetic_infra/hermit:"],
)
