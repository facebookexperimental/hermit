pkg
.buckd
.tmp*
target/
*.preempts

# pr-dag-health.sh report artifact (regenerate with the script)
pr-dag-health.json

# validate.sh live working-envelope measurement (regenerate with --envelope-only).
# The committed baseline lives in envelope-baseline.json; this is the fresh run.
envelope.json

# validate.rs checkout-local validation ledger (used when neither
# HERMIT_VALIDATE_LEDGER nor DEV_HERMIT_PARENT is set). Disposable per-checkout
# receipts, regenerated on every run.
.hermit-validate-ledger.jsonl

# Local backup and Python cache files.
*.orig
**/__pycache__/
**/.mypy_cache/

# Generated validation/e2e output. Everything under ignored/ is disposable and
# must not taint source provenance or the version string.
/ignored/

# Backend-parity observations belong to the outer dev-hermit compat scorecard.
/tests/backend-parity/matrix.tsv
