        ],
    }.items()
]

# cxx_genrule selects the configured compiler but does not provide RunInfo.
# Keep the public targets executable and expose the ELF itself to Hermit.
cxx_genrule(
    name = "minimal_hello_compile",
    srcs = ["//hermetic_infra/hermit/tests/c/simple:hello_nostdlib.c"],
    out = "minimal_hello.bin",
    cmd = "$(cc) -g -nostdlib $SRCS -o $OUT",
)

buck_genrule(
    name = "minimal_hello",
    out = "minimal_hello.bin",
    cmd = 'cp "$(location :minimal_hello_compile)" "$OUT"',
    executable = True,
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

cxx_genrule(
    name = "racewrite_nostdlib_compile",
    srcs = ["//hermetic_infra/hermit/tests/c/simple:racewrite_nostdlib.c"],
    out = "racewrite_nostdlib.bin",
    cmd = "$(cc) -g -nostdlib $SRCS -o $OUT",
)

buck_genrule(
    name = "racewrite_nostdlib",
    out = "racewrite_nostdlib.bin",
    cmd = 'cp "$(location :racewrite_nostdlib_compile)" "$OUT"',
    executable = True,
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

