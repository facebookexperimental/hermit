# Guests whose assertions need a single-threaded process. The default Rust
# allocator starts a background thread before main, so these use malloc (the
# same reason as the allocator overrides above;
# https://github.com/rrnewton/hermit/issues/3419).
single_threaded_rs = [
    "rust/tkill.rs",
]

# fbsource-disabled: replay of select/pselect6 on a ready fd returns 0
# (https://github.com/rrnewton/hermit/issues/3569, T137258824).
record_and_replay_exempt_rs = [
    "rust/select.rs",
]

# TODO(T124837711): get the rest of the tests working under trace replay:
tracereplay_exempt_rs = [
    "rust/bind_connect_race.rs",
    "rust/clock_total_order.rs",
    "rust/exit_group.rs",
    # Seems to run tid 9 instead of tid 3:
    "rust/futex_and_print.rs",
    "rust/futex_wake_some.rs",
    "rust/poll_spin.rs",
    "rust/thread_random.rs",
]

[
    hermit_rust_test(
        allocator = "malloc" if p in single_threaded_rs else None,
        chaos = True,
        # TODO(T124815884): add disabled test(s) as they work:
        chaosreplay = (p != "rust/thread_random.rs") and (p != "rust/poll_spin.rs"),
        no_deterministic_io = False,
        no_sequentialize_threads = False,
        path = p,
        raw = True,
        record_and_replay = not p in record_and_replay_exempt_rs,
        run = True,
        tracereplay = not p in tracereplay_exempt_rs,
        tracereplay_chaos = not p in tracereplay_exempt_rs
        and not p
        in [
            "rust/print_nanosleep_race.rs",
            "rust/print_clock_nanosleep_monotonic_abs_race.rs",
            "rust/print_clock_nanosleep_monotonic_race.rs",
            "rust/print_clock_nanosleep_realtime_abs_race.rs",
        ],
    )
    for p in glob(["rust/*.rs"])
]

[
    hermit_rust_test(
        chaos = False,
        chaosreplay = True,
        no_deterministic_io = True,
        no_sequentialize_threads = True,
