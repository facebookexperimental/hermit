wrap_test_suite(
    args = [
        "run",
        "--base-env=minimal",
        "--verify",
        "--preemption-timeout=80000000",
        "--workdir=/tmp",
    ],
    exclude = RR_HERMIT_EXCLUDED,
    # Upstream's rr suite #[ignore]s these, with these reasons; see
    # fb-only/rr_tests/upstream_ignored.bzl.
    ignored = RR_UPSTREAM_IGNORED,
    name_prefix = "test_hermit_strict__",
    # --verify accepts only a successful first run by default. A program
    # expected to exit nonzero (rr_pause) is still run twice and compared.
    nonzero_exit_args = ["--verify-allow=failure"],
    # Every rr test this suite runs starts Hermit's ptrace backend with
    # virtual CPUID, which needs CPUID faulting. rr_syscall_bp also needs a
    # writable procfs in fresh namespaces: run_gated.py's `a+b` probes both.
    requires = {
        name: (
            "cpuid-faulting+userns-mount",
            CPUID_FAULTING_REASON
            + "; and it opens /proc/self/mem O_RDWR, which needs a writable procfs mounted in fresh user, mount and PID namespaces (where refused, Hermit falls back to a read-only /proc and the open fails with EROFS)",
        )
        if name == "rr_syscall_bp"
        else ("cpuid-faulting", CPUID_FAULTING_REASON)
        for name in RR_TEST_TARGETS
        if name not in RR_HERMIT_EXCLUDED and name not in RR_UPSTREAM_IGNORED
    },
    suite_name = "rr_tests",
    target = "//hermetic_infra/hermit/hermit-cli:hermit",
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    test_targets = RR_TEST_TARGETS,
)

# The repository's tests/ directory as hermit-cli's Cargo integration tests
# see it: they compile guests from these sources at run time.
buck_filegroup(
    name = "integration-tree",
    srcs = {sub: "//hermetic_infra/hermit/tests/{}:guest-sources".format(sub) for sub in ["bin", "c", "debugger", "runtime", "util"]}
    | {
        src: src
        for src in glob(
            ["**"],
            exclude = [
                "BUCK",
                "bin/**",
                "c/**",
                "debugger/**",
                "runtime/**",
                "util/**",
            ],
        )
    },
    visibility = [
        "//hermetic_infra/hermit:",
        "//hermetic_infra/hermit/fb-only/integration_tests/tests:",
    ],
)

record_c_workloads("tests")
