# TODO: Analyze v2 of cas_sequence is currently broken
[
    hermit_host_test(
        name = "analyze_" + name,
        # Fails on RE workers (measured 2026-10-28, re-cpuid RE pass); keep local pending investigation.
        allow_cpuid_re = False,
        args = [
            "$(location //hermetic_infra/hermit/hermit-cli:hermit)",
            target,
        ],
        env = {
            "ANALYZE_OPTS": analyze_opts,
            "EXPECTED_OUTPUT": expected_output,
        },
        test = "//hermetic_infra/hermit/tests/util:hermit_analyze_test.sh",
    )
    for (name, target, analyze_opts, expected_output) in [
        # ("hello_race_mini", "$(location //hermetic_infra/hermit/flaky-tests:hello_race_mini)", "", ""),
        # TODO: switch to --base-env=empty:
        (
            "hello_race",
            "$(location //hermetic_infra/hermit/flaky-tests:hello_race)",
            "--run-arg=--base-env=host",
            "",
        ),
        # This one doesn't crash/exit-with-error, rather it is detected based on stdout.
        # Here we require the test to blame a specific line.  Must be updated if the file changes:
        (
            "racewrite_nostdlib",
            "$(location //hermetic_infra/hermit/tests:racewrite_nostdlib)",
            # The non-chaos baseline now prints barfoo, so analyze the opposite
            # write order to keep the endpoints distinct (as OSS
            # hermit-cli/tests/analyze.rs does).
            "--selfcheck --run-arg=--base-env=empty --target-exit-code=0 --target-stdout=foobar",
            "simple/racewrite_nostdlib.c:35",
        ),
        # TODO: enable more analyze tests:
        # ("cas_sequence", "$(location //hermetic_infra/hermit/tests:chaos_cas_sequence_bin)"),
        # nanosleep-threads-nocrash is not here: its baseline run also exits 0,
        # so analyze correctly refuses ("baseline run matched target criteria
        # when it should not"). OSS asserts that refusal in
        # hermit-cli/tests/analyze.rs
        # (analyze_nanosleep_threads_rejects_indistinguishable_baseline), but
        # that test is #[ignore]d (slow, needs PMU counters) and no OSS
        # validate node runs it.
    ]
]

