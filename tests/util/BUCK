# @lint-ignore-every AUTODEPS2
# These host capability probes are not part of the fbsource Buck graph.

load("@fbcode_macros//build_defs:export_files.bzl", "export_file")
load("@fbcode_macros//build_defs:native_rules.bzl", "buck_filegroup")

oncall("hermit")

# Guest sources for hermit-cli's Cargo integration tests (see
# //hermetic_infra/hermit/tests:integration-tree).
buck_filegroup(
    name = "guest-sources",
    srcs = glob(["**"], exclude = ["BUCK"]),
    visibility = ["//hermetic_infra/hermit/tests/..."],
)

# Named by label from tests/BUCK; a package may not list another package's
# files as sources.
export_file(
    name = "hermit_verify_trace_replay.sh",
    src = "hermit_verify_trace_replay.sh",
)

export_file(
    name = "hermit_analyze_test.sh",
    src = "hermit_analyze_test.sh",
)

export_file(
    name = "simplest_server.py",
    src = "simplest_server.py",
)

export_file(
    name = "chaos_stress_wrapper.sh",
    src = "chaos_stress_wrapper.sh",
)
