# @lint-ignore-every AUTODEPS2
# These external debugger tests are not part of the fbsource Buck graph.

load("@fbcode_macros//build_defs:export_files.bzl", "buck_export_file")
load("@fbcode_macros//build_defs:native_rules.bzl", "buck_filegroup")

oncall("hermit")

# Guest sources for hermit-cli's Cargo integration tests (see
# //hermetic_infra/hermit/tests:integration-tree).
buck_filegroup(
    name = "guest-sources",
    srcs = {
        "guests": "//hermetic_infra/hermit/tests/debugger/guests:guest-sources",
    }
    | {src: src for src in glob(["**"], exclude = ["BUCK"])},
    visibility = ["//hermetic_infra/hermit/tests/..."],
)

# Upstream's test inventory names this file; the glob above skips dotfiles. The
# e2e source snapshot (//hermetic_infra/hermit/ci/buck-e2e:src) copies it.
buck_export_file(
    name = ".gitignore",
    visibility = ["//hermetic_infra/hermit/ci/buck-e2e:"],
)
