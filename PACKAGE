load("@fbcode_macros//build_defs:link_group_registry.bzl", "link_group_registry")
load("@fbcode_macros//build_defs/lib:third_party.bzl", "third_party")
load("@fbsource//tools/build_defs:rust_package_local.bzl", "rust_package_local")
load("@fbsource//tools/target_determinator/macros:ci.bzl", "ci")
load("@prelude//cfg/modifier:set_cfg_modifiers.bzl", "set_cfg_modifiers")

rust_package_local.set_rustc_flags([
    "-Dwarnings",  # Match `fbcode/hermetic_infra/hermit/fb-only/ci.sh`
])

ci.package(
    ci.replace({
        ci.linux(ci.dev()): ci.linux(
            ci.mode("fbcode//mode/dev-nosan"),
        )
    }),
    ci.continuous_only(ci.linux(ci.selective_coverage())),
)

link_group_registry.use_link_groups(dev = True)

modifiers_list = third_party.versions({
    "llvm-fb": "21",
})
set_cfg_modifiers(cfg_modifiers = modifiers_list)
