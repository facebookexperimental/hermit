load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("hermit")

# Rust glue linked into the feature-complete Hermit binary. The separately
# packaged cdylib and DynamoRIO/native resources remain Cargo-owned in Phase 1.
rust_library(
    name = "detcore-dbt",
    srcs = glob(["src/**/*.rs"]),
    autocargo = {"cargo_toml_dir": "."},
    deps = [
        "fbsource//third-party/rust:libc",
        "fbsource//third-party/rust:rand",
        "fbsource//third-party/rust:reverie-dbt",
        "fbsource//third-party/rust:serde_json",
        "fbsource//third-party/rust:tracing",
        "//hermetic_infra/hermit/detcore:detcore",
        "//hermetic_infra/hermit/hermit-resources:hermit-resources",
        "//hermetic_infra/reverie:reverie",
    ],
)
