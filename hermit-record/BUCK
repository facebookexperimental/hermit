load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("hermit")

# Hermit's ptrace recording tool and the root of its Detcore instantiation,
# compiled apart from the hermit library so it builds in parallel.
rust_library(
    name = "hermit-record",
    srcs = glob(["src/**/*.rs"]),
    autocargo = {"cargo_toml_dir": "."},
    deps = [
        "fbsource//third-party/rust:bincode",
        "fbsource//third-party/rust:libc",
        "fbsource//third-party/rust:serde",
        "fbsource//third-party/rust:tempfile",
        "fbsource//third-party/rust:tracing",
        "//hermetic_infra/hermit/detcore:detcore",
        "//hermetic_infra/hermit/hermit-record-format:hermit-record-format",
        "//hermetic_infra/reverie:reverie",
        "//hermetic_infra/reverie:reverie-ptrace",
    ],
)
