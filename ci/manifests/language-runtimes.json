{
  "schema": 2,
  "bucket": "language-runtimes",
  "tests": [
    {
      "id": "language-runtimes/python-random",
      "category": "language-runtimes",
      "description": "Python random output varies natively and repeats under Hermit",
      "lane": "portable",
      "program": {"kind": "shell", "path": "tests/e2e/language-runtimes/python-random.sh", "prepare-args": ["--prepare"], "run-args": ["--run"]},
      "requires": ["linux", "x86_64", "userns", "ptrace", "python3"],
      "timeout-seconds": 90,
      "observation": {"status": true, "stdout": true, "stderr": false, "artifacts": []},
      "modes": [
        {"mode": "naked", "ci": false, "runs": 3, "assert": {"min-distinct": 2}, "backends-enabled": ["native"], "backends-disabled": []},
        {"mode": "verify", "ci": true, "backends-enabled": ["ptrace"], "backends-disabled": [
          {"backend": "dbi", "why": "DBI Python support is tracked by backend compatibility"},
          {"backend": "kvm", "why": "KVM Python coverage is in the privileged applications bucket"},
          {"backend": "sabre", "why": "SaBRe requires its external runtime"},
          {"backend": "liteinst", "why": "LiteInst Python support is tracked by backend compatibility"}
        ]},
        {"mode": "replay", "ci": false, "backends-enabled": [], "backends-disabled": [
          {"backend": "ptrace", "why": "The focused C sentinel owns the blocking replay contract"},
          {"backend": "dbi", "why": "Record/replay is unsupported by DBI"},
          {"backend": "kvm", "why": "Record/replay is unsupported by KVM"},
          {"backend": "sabre", "why": "Record/replay is unsupported by SaBRe"},
          {"backend": "liteinst", "why": "Record/replay is unsupported by LiteInst"}
        ]},
        {"mode": "chaos", "ci": false, "backends-enabled": [], "backends-disabled": [
          {"backend": "ptrace", "why": "The Python example is single-threaded"},
          {"backend": "dbi", "why": "Chaos scheduling is unsupported by DBI"},
          {"backend": "kvm", "why": "Chaos scheduling is unsupported by KVM"},
          {"backend": "sabre", "why": "Chaos scheduling is unsupported by SaBRe"},
          {"backend": "liteinst", "why": "Chaos scheduling is unsupported by LiteInst"}
        ]},
        {"mode": "custom", "ci": false, "backends-enabled": [], "backends-disabled": [
          {"backend": "ptrace", "why": "No edge-case Hermit arguments are required"},
          {"backend": "dbi", "why": "No edge-case Hermit arguments are required"},
          {"backend": "kvm", "why": "No edge-case Hermit arguments are required"},
          {"backend": "sabre", "why": "No edge-case Hermit arguments are required"},
          {"backend": "liteinst", "why": "No edge-case Hermit arguments are required"}
        ]}
      ],
      "occasional": false
    }
  ]
}
