load("@fbcode_macros//build_defs:export_files.bzl", "buck_export_file")
load("@fbsource//tools/build_defs:rust_binary.bzl", "rust_binary")
load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("hermit")

# Hermit's validation planner and e2e test harness (Cargo: hermit-manifest-plan),
# ported from upstream's public Buck build of this package (ci/manifest-plan/BUCK):
# the same library and the bins the fbsource e2e cells use (ci/buck-e2e). Buck and
# Tpx schedule the cells; dagrun's library is linked (fb-only/dagrun), not its
# scheduler. The library includes thirteen files verbatim via #[path] modules
# from sibling packages; they arrive through mapped_srcs, as upstream maps them,
# and lib.rs selects those paths under --cfg=buck_build.
#
# No target names an edition: fbsource refuses a non-default edition for
# first-party code (tools/build_defs/lib/rust/rust_common.bzl), so it compiles
# this package as its default, 2024. The open-source build compiles it as
# edition 2021, the edition of the crate's Cargo manifest, through
# `default_edition:ci/manifest-plan` in its .buckconfig.
#
# unittests = False on every target: as in upstream's Buck build, the crate's
# own unit tests stay Cargo-run (validate). They need the toml dev-dependency
# and include_str! test inputs outside this package (ci/dag/validate.json,
# ci/portable-shards.json, tests/fixtures/), which these targets do not declare.
_DEPS = [
    "fbsource//third-party/rust:chrono",
    "fbsource//third-party/rust:libc",
    "fbsource//third-party/rust:serde",
    "fbsource//third-party/rust:serde_json",
    "fbsource//third-party/rust:serde_yaml",
    "fbsource//third-party/rust:sha2-010",
    "fbsource//third-party/rust:shell-words",
    "//hermetic_infra/hermit/detcore-model:detcore-model",
    "//hermetic_infra/hermit/fb-only/dagrun:dagrun",
]

rust_library(
    name = "manifest-plan",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/bin/**",
            "src/main.rs",
        ],
    ),
    crate = "hermit_manifest_plan",
    mapped_srcs = {
        "//hermetic_infra/hermit/detcore-model:canonical_test_epoch.rs": "detcore-model/src/canonical_test_epoch.rs",
        "//hermetic_infra/hermit/hermit-cli:canonical_verdict.rs": "mapped/hermit-cli/canonical_verdict.rs",
        "//hermetic_infra/hermit/hermit-cli:logdiff_report.rs": "mapped/hermit-cli/logdiff_report.rs",
        "//hermetic_infra/hermit/hermit-cli:proc_locks_lease.rs": "mapped/hermit-cli/proc_locks_lease.rs",
        "//hermetic_infra/hermit/hermit-cli:verify_run_record.rs": "mapped/hermit-cli/verify_run_record.rs",
        "//hermetic_infra/hermit/scripts:validate_corpus.rs": "mapped/scripts/validate_corpus.rs",
        "//hermetic_infra/hermit/scripts:validate_generator.rs": "mapped/scripts/validate_generator.rs",
        "//hermetic_infra/hermit/scripts:validate_plan.rs": "mapped/scripts/validate_plan.rs",
        "//hermetic_infra/hermit/scripts:validate_super.rs": "mapped/scripts/validate_super.rs",
        "//hermetic_infra/hermit:ci/cargo-guest-binaries.rs": "mapped/ci/cargo-guest-binaries.rs",
        "//hermetic_infra/hermit:ci/dag-source-ownership.json": "dag-source-ownership.json",
        "//hermetic_infra/hermit:ci/lit-guest-binaries.rs": "mapped/ci/lit-guest-binaries.rs",
        "//hermetic_infra/hermit:ci/record-replay-workloads.rs": "mapped/ci/record-replay-workloads.rs",
    },
    rustc_flags = ["--cfg=buck_build"],
    unittests = False,
    deps = _DEPS,
)

rust_binary(
    name = "hermit-manifest-plan",
    # main.rs recompiles manifest_value directly (mod decl), as under Cargo.
    srcs = [
        "src/main.rs",
        "src/manifest_value.rs",
    ],
    crate = "hermit_manifest_plan_bin",
    crate_root = "src/main.rs",
    # The e2e bundle copies both binaries into one bin/ directory, where
    # test-harness finds hermit-manifest-plan beside its own executable.
    link_style = "static",
    unittests = False,
    deps = [
        "fbsource//third-party/rust:serde",
        "fbsource//third-party/rust:serde_json",
        "fbsource//third-party/rust:serde_yaml",
        ":manifest-plan",
    ],
)

rust_binary(
    name = "test-harness",
    srcs = ["src/bin/test-harness.rs"],
    crate = "test_harness",
    crate_root = "src/bin/test-harness.rs",
    link_style = "static",
    unittests = False,
    deps = [
        "fbsource//third-party/rust:serde_json",
        "fbsource//third-party/rust:serde_yaml",
        ":manifest-plan",
        "//hermetic_infra/hermit/fb-only/dagrun:dagrun",
    ],
)

# The rest of the bins Cargo builds with `cargo build -p hermit-manifest-plan
# --bins`, each with the dependencies it uses beside the library (fbsource
# refuses an unused one). With the two above they are the open-source build's
# Buck pilot for validate's setup.manifest_plan node (dh-cqlkz). autocargo
# skips them (ignore_rule).
_PILOT_BINS = {
    "bind-executable": ["fbsource//third-party/rust:serde_json"],
    "generate-parity-cells": [],
    "generate-test-footprints": [
        "fbsource//third-party/rust:serde_json",
        "//hermetic_infra/hermit/fb-only/dagrun:dagrun",
    ],
    "generate-validation-dag": [],
    "manifest-metadata": ["fbsource//third-party/rust:serde_json"],
    "nextest-cpu-wrapper": [
        "fbsource//third-party/rust:libc",
        "fbsource//third-party/rust:serde_json",
        "fbsource//third-party/rust:sha2-010",
        "//hermetic_infra/hermit/detcore-model:detcore-model",
    ],
    "strict-green-authority": [
        "fbsource//third-party/rust:serde",
        "fbsource//third-party/rust:serde_json",
        "fbsource//third-party/rust:sha2-010",
    ],
    "with-bound-command": [],
}

[
    rust_binary(
        name = name,
        srcs = ["src/bin/{}.rs".format(name)],
        autocargo = {"ignore_rule": True},
        crate = name.replace("-", "_"),
        crate_root = "src/bin/{}.rs".format(name),
        unittests = False,
        deps = [":manifest-plan"] + deps,
    )
    for name, deps in _PILOT_BINS.items()
]

# The per-test budgets the integration-test generator carries into DAG nodes.
buck_export_file(
    name = "src/timeouts.rs",
    visibility = ["//hermetic_infra/hermit/fb-only/integration_tests/tests:"],
)

# This package's Cargo manifest, for the tree check.backend_abstraction runs
# on (//hermetic_infra/hermit:backend-abstraction-repository).
buck_export_file(
    name = "Cargo.toml",
    visibility = ["//hermetic_infra/hermit:"],
)
