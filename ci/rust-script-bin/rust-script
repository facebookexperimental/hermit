#!/usr/bin/env bash
# Execute only rust-script binaries prepared by ci/prepare-rust-scripts.sh.

set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
PUBLISHED="${HERMIT_RUST_SCRIPT_ARTIFACT_ROOT:-$ROOT_DIR/target/ci/rust-scripts}"
MANIFEST="$PUBLISHED/manifest.tsv"
original_args=("$@")

resolve_optional=false
if [[ ${1:-} == --resolve-optional ]]; then
    resolve_optional=true
    shift
    if [[ ${1:-} == --help || ${1:-} == -h ]]; then
        printf '%s\n' 'usage: rust-script --resolve-optional [--force] SOURCE' \
            'Resolve a repository-owned prepared executable without running or compiling it.' \
            'Exit 0 prints its checked absolute path; 3 means absent optional producer output; 2 means invalid preparation or ownership.'
        exit 0
    fi
fi

die() {
    printf 'prebuilt rust-script: %s\n' "$*" >&2
    exit 2
}

find_real_rust_script() {
    local candidate dir
    if [[ -n ${HERMIT_REAL_RUST_SCRIPT:-} ]]; then
        [[ -x $HERMIT_REAL_RUST_SCRIPT ]] || die "HERMIT_REAL_RUST_SCRIPT is not executable: $HERMIT_REAL_RUST_SCRIPT"
        printf '%s\n' "$HERMIT_REAL_RUST_SCRIPT"
        return
    fi
    IFS=: read -ra path_entries <<<"${PATH:-}"
    for dir in "${path_entries[@]}"; do
        [[ -n $dir ]] || dir=.
        candidate=$dir/rust-script
        [[ -x $candidate ]] || continue
        if [[ $(realpath -- "$candidate") != "$ROOT_DIR/ci/rust-script-bin/rust-script" ]]; then
            realpath -- "$candidate"
            return
        fi
    done
    die "real rust-script executable not found outside ci/rust-script-bin"
}

for argument in "$@"; do
    if [[ $argument == --package || $argument == -p ]]; then
        "$resolve_optional" && die "--resolve-optional never generates packages; use --resolve-optional --help"
        # Package generation writes Rust and Cargo metadata but performs no
        # compilation. validate's cache self-test needs this mode to inspect
        # rust-script's package placement before the DAG begins.
        real_rust_script=$(find_real_rust_script)
        exec "$real_rust_script" "$@"
    fi
    # Stop at the source operand. Everything after it belongs to the prepared
    # program, where flags such as Nextest's `-p PACKAGE` must not be mistaken
    # for rust-script's own package-generation mode. Run 35342226342 made that
    # mistake after entering hosted network isolation and delegated the already
    # prepared nextest-binaries.rs back to the compiler.
    if [[ $argument != -* ]]; then
        break
    fi
done

case ${1:-} in
    --version|-V|--help|-h)
        "$resolve_optional" && die "--resolve-optional accepts a source path, not runner queries; use --resolve-optional --help"
        if [[ $1 == --help || $1 == -h ]]; then
            printf '%s\n' 'Prepared runner additionally supports --resolve-optional [--force] SOURCE (0 checked path, 3 absent, 2 invalid; never compiles).'
        fi
        # These queries do not compile anything. Keep tooling probes compatible
        # without pretending that they consumed a prepared repository script.
        real_rust_script=$(find_real_rust_script)
        exec "$real_rust_script" "$@"
        ;;
esac

mode=run
while (($#)); do
    case $1 in
        --force|--cargo-output)
            shift
            ;;
        --test)
            mode='test'
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "unsupported option $1; the validation graph may only run prepared scripts"
            ;;
        *)
            break
            ;;
    esac
done

(($#)) || die "missing script path"
source=$1
shift
if "$resolve_optional"; then
    [[ $mode == run && $# == 0 ]] || die "--resolve-optional requires only one source; use --resolve-optional --help"
fi

execute_script() {
    if [[ $mode == test ]]; then
        exec "$ROOT_DIR/ci/rust-script-bin/run-test-harness" "$source" -- "$@"
    fi
    exec "$@"
}

if ! "$resolve_optional"; then
    [[ -f $MANIFEST ]] || die "missing producer output $MANIFEST; require build.rust_scripts before this node"
fi
source_abs=$(realpath -- "$source") || die "cannot resolve script path $source"
case $source_abs in
    "$ROOT_DIR"/*)
        # Ownership is a property of the script's own directory. Git exports
        # GIT_DIR, GIT_WORK_TREE and GIT_INDEX_FILE to hooks and `git rebase
        # --exec` steps, and they override `git -C`: under an inherited GIT_DIR
        # the lookup reports the script's directory as a separate checkout and
        # delegates to the compiler, and under GIT_WORK_TREE it reports the
        # caller's tree (https://github.com/rrnewton/hermit/issues/3362). The
        # command substitution's subshell drops them for this lookup only.
        if ! source_root=$(
            unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
                GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_PREFIX
            git -C "$(dirname -- "$source_abs")" rev-parse --show-toplevel 2>/dev/null
        ); then
            die "cannot establish Git ownership for repository script $source_abs"
        fi
        [[ -n $source_root && -d $source_root ]] ||
            die "cannot establish Git ownership for repository script $source_abs: invalid root $source_root"
        source_root=$(realpath -- "$source_root") ||
            die "cannot establish Git ownership for repository script $source_abs: cannot resolve root"
        case $source_abs in
            "$source_root"/*) ;;
            *) die "cannot establish Git ownership for repository script $source_abs: root does not contain source" ;;
        esac
        if [[ $source_root != "$ROOT_DIR" ]]; then
            case $source_root in
                "$ROOT_DIR"/*) ;;
                *) die "cannot establish Git ownership for repository script $source_abs: root is outside checkout" ;;
            esac
            "$resolve_optional" && die "optional source belongs to a different Git checkout; use its own prepared runner"
            # A separate fixture checkout below target owns its own scripts.
            # Failed ownership lookup must never authorize a compiler fallback.
            real_rust_script=$(find_real_rust_script)
            execute_script "$real_rust_script" "${original_args[@]}"
        fi
        source_rel=${source_abs#"$ROOT_DIR"/}
        ;;
    *)
        "$resolve_optional" && die "optional source is outside this checkout; use its own prepared runner"
        # The validation environment also launches rust-script programs owned
        # by its external operational tooling. This repository cannot prepare
        # those sources, so leave that separate checkout to its own runner.
        real_rust_script=$(find_real_rust_script)
        execute_script "$real_rust_script" "${original_args[@]}"
        ;;
esac

if "$resolve_optional"; then
    [[ -e $MANIFEST || -L $MANIFEST ]] || exit 3
    [[ -f $MANIFEST && ! -L $MANIFEST ]] || die "invalid optional producer manifest; refresh build.rust_scripts"
    awk -F '\t' 'NF != 3 || $1 == "" || $2 == "" || $3 == "" || seen[$1]++ { exit 1 }' "$MANIFEST" || die "malformed or duplicate optional producer manifest; refresh build.rust_scripts"
    row=$(awk -F '\t' -v source="$source_rel" '$1 == source { print }' "$MANIFEST") || die "cannot read optional producer manifest"
    [[ -n $row ]] || exit 3
    [[ $row != *$'\n'* ]] || die "producer manifest has duplicate entries for $source_rel"
    [[ $(awk -F '\t' 'NF == 3 && $1 != "" && $2 != "" && $3 != "" { print "valid" }' <<<"$row") == valid ]] || die "malformed producer manifest row for $source_rel"
else
row=$(awk -F '\t' -v source="$source_rel" '$1 == source { print; found++ } END { if (found != 1) exit 1 }' "$MANIFEST") ||
    die "producer manifest has no unique entry for $source_rel"
fi
IFS=$'\t' read -r recorded run_path test_path <<<"$row"
[[ $recorded == "$source_rel" ]] || die "producer manifest returned the wrong script: $recorded"

case $mode in
    run) selected=$run_path ;;
    test)
        [[ $test_path != - ]] || die "$source_rel has no test harness in the producer manifest"
        selected=$test_path
        ;;
esac
case $selected in
    /*) die "producer manifest contains an absolute artifact path for $source_rel" ;;
    ../*|*/../*|*/..|..) die "producer manifest path escapes its directory for $source_rel" ;;
esac
binary="$PUBLISHED/$selected"
if "$resolve_optional"; then
    candidate=$(realpath -m -- "$binary") || die "cannot resolve optional artifact path"
    case $candidate in
        "$PUBLISHED"/*) ;;
        *) die "optional artifact path escapes producer output: $candidate" ;;
    esac
    [[ -e $binary || -L $binary ]] || exit 3
fi
[[ -f $binary && -x $binary ]] || die "prepared $mode binary is missing or not executable: $binary"
binary_abs=$(realpath -- "$binary") || die "cannot resolve prepared $mode binary: $binary"
case $binary_abs in
    "$PUBLISHED"/*) ;;
    *) die "prepared $mode binary escapes producer output: $binary_abs" ;;
esac

if "$resolve_optional"; then
    printf '%s\n' "$binary_abs"
    exit 0
fi
execute_script "$binary_abs" "$@"
