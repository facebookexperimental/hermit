{
  "resource_caps": {"kvm": 1},
  "mem_cap_factor": 1.25,
  "mem_cap_floor_bytes": 8589934592,
  "outer_mem_safety_factor": 1.0,
  "default_step_timeout": 120,
  "steps": [
    {
      "group": "check", "job": "reverie_pin",
      "desc": "Require Hermit's recorded Reverie revision to equal latest rrnewton/reverie:main",
      "cmd": "./ci/run-reverie-pin-check.sh",
      "timeout": 120,
      "hint": {"est_duration_s": 5, "rss_baseline_bytes": 67108864,
               "hard_mem_max_bytes": 536870912, "classification": "light"}
    },
    {
      "group": "build", "job": "privileged_tests",
      "desc": "Build Hermit and the focused test binaries used by the privileged lane",
      "description": "MEM-CAP DERIVATION 2026-08-04 (follow-on to task memory-caps-must-scale-with-job-count / #1583, which MISSED this privileged-lane build node): pinned_jobs=8 literal via CARGO_BUILD_JOBS=8 prefix on BOTH build commands (was unset -> both cargo build and cargo test --no-run defaulted their build phase to nproc; that cc1plus fan-out is the OOM class the pin bounds; the job-pin is the actual fix). Cap KEPT at the existing generous 8.0GiB: a warm/incremental measurement read peak_bytes~1.64GiB @j8, but that reused build.workspace artifacts and UNDER-estimates a cold from-scratch privileged build, so the 8.0GiB headroom is retained rather than tightened on an unreliable warm figure. rss_baseline=5.0GiB (scheduling reservation). hermit@b384187e.",
      "cmd": "CARGO_BUILD_JOBS=8 cargo build -p hermit --features third-party-backends --bin hermit && CARGO_BUILD_JOBS=8 cargo test -p detcore --test tests_misc --no-run",
      "deps": ["e2e.metadata"],
      "timeout": 120,
      "hint": {"est_duration_s": 60, "rss_baseline_bytes": 5368709120,
               "hard_mem_max_bytes": 8589934592, "classification": "cpu-bound"}
    },
    {
      "group": "cpuid", "job": "faulting",
      "desc": "CPUID-faulting smoke: Detcore masks host RDRAND/RDSEED feature bits",
      "cmd": "timeout 30 cargo test -p detcore --test tests_misc rdrand_rdseed_is_masked -- --exact",
      "deps": ["build.privileged_tests"],
      "timeout": 40,
      "hint": {"est_duration_s": 15,
               "rss_baseline_bytes": 8589934592, "hard_mem_max_bytes": 17179869184,
               "classification": "cpu-bound"}
    },
    {
      "group": "pmu", "job": "preemption",
      "desc": "PMU smoke: retired-conditional-branch overflow delivery and skid measurement",
      "cmd": "cc -O2 -Wall -Wextra -Werror tests/util/pmu_skid.c -o target/ci-pmu-skid && timeout 20 target/ci-pmu-skid --iterations 16 --period 100000",
      "deps": ["build.privileged_tests"],
      "timeout": 30,
      "hint": {"est_duration_s": 5,
               "rss_baseline_bytes": 8589934592, "hard_mem_max_bytes": 17179869184,
               "classification": "cpu-bound"}
    },
    {
      "group": "e2e", "job": "metadata",
      "desc": "Validate E2E metadata, generated test footprints, and required-cell plan",
      "cmd": "./ci/test_harness.sh validate",
      "timeout": 20,
      "hint": {"est_duration_s": 5,
               "rss_baseline_bytes": 268435456, "hard_mem_max_bytes": 1073741824,
               "classification": "light"}
    },
    {
      "group": "build", "job": "manifest_guests",
      "desc": "Prepare every CI-enabled privileged manifest guest",
      "cmd": "./ci/test_harness.sh build --lane privileged --ci-only --allow-empty",
      "deps": ["e2e.metadata"],
      "timeout": 120,
      "hint": {"est_duration_s": 75,
               "rss_baseline_bytes": 1073741824, "hard_mem_max_bytes": 3221225472,
               "classification": "cpu-bound"}
    },
    {
      "group": "e2e", "job": "manifest_applications",
      "desc": "Privileged manifest bucket: applications",
      "manifest": {"lane": "privileged", "category": "applications"},
      "cmd": "./ci/test_harness.sh run --lane privileged --category applications --ci-only --allow-empty --prebuilt --results ignored/e2e/privileged/applications/results.jsonl --junit ignored/e2e/privileged/applications/junit.xml",
      "deps": ["build.privileged_tests", "build.manifest_guests", "e2e.metadata"],
      "timeout": 130,
      "hint": {"resources": {"kvm": 1}, "est_duration_s": 90,
               "rss_baseline_bytes": 8589934592, "hard_mem_max_bytes": 17179869184,
               "classification": "latency-bound"}
    },
    {
      "group": "e2e", "job": "manifest_backend_parity_c",
      "desc": "Privileged manifest bucket: backend-parity-c",
      "manifest": {"lane": "privileged", "category": "backend-parity-c"},
      "cmd": "./ci/test_harness.sh run --lane privileged --category backend-parity-c --ci-only --allow-empty --prebuilt --results ignored/e2e/privileged/backend-parity-c/results.jsonl --junit ignored/e2e/privileged/backend-parity-c/junit.xml",
      "deps": ["build.privileged_tests", "build.manifest_guests", "e2e.metadata"],
      "timeout": 120,
      "hint": {"resources": {"kvm": 1}, "est_duration_s": 5,
               "rss_baseline_bytes": 8589934592, "hard_mem_max_bytes": 17179869184,
               "classification": "latency-bound"}
    }
  ]
}
