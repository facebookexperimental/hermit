      "paths": ["hermit-cli/tests/random_determinism.rs"],
      "nodes": ["super.random_source_determinism_diagnostic"]
    },
    {
      "_why": "Super nextest diagnostics select these hermit-cli test files by name; a test added there runs only in its super node.",
      "paths": ["hermit-cli/tests/integration_matrix.rs"],
      "nodes": ["super.threaded_integration_matrix_diagnostic"]
    },
    {
      "_why": "Super nextest diagnostics select these hermit-cli test files by name; a test added there runs only in its super node.",
      "paths": ["hermit-cli/tests/hermit_modes.rs"],
      "nodes": [
        "super.chaos_hello_race_verification_diagnostic",
        "super.pmu_buck_chaos_cases",
        "super.weekly_relaxed_default_mode_cases"
