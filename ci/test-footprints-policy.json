{
  "_comment": [
    "Policy inputs that Cargo metadata cannot derive for ci/test-footprints.json.",
    "Run `cargo run -p hermit-manifest-plan --bin generate-test-footprints` after",
    "changing this file, the workspace Cargo graph, or ci/dag/validate.json.",
    "",
    "Keep ci_irrelevant deliberately narrow: it is the only classification that can",
    "skip CI. Unmatched paths still force the complete suite. Package Rust sources,",
    "manifests, reverse dependencies, and Cargo-command DAG nodes are generated.",
    "package_paths adds package-local fixtures/resources that Cargo metadata cannot name."
  ],
  "version": 1,
  "force_full": [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    ".cargo/**",
    "ci/**",
    "scripts/validate.rs",
    "scripts/lib/**",
    ".github/workflows/ci-portable.yml",
    ".github/workflows/merge-gate.yml",
    ".github/workflows/ci-privileged.yml",
    ".github/actions/**"
  ],
  "ci_irrelevant": [
    "**/*.md",
    "docs/**",
    "ai_docs/**",
    "experiments/**",
    "LICENSE",
    "CODEOWNERS",
    ".gitignore",
    "**/.gitignore",
    ".gitattributes",
    ".editorconfig",
    "**/*.png",
    "**/*.svg",
    "**/*.jpg",
    ".github/**"
  ],
  "package_paths": {
    "hermit-detcore": ["detcore/**"],
    "hermetic_infra_hermit_flaky-tests": ["flaky-tests/**"],
    "hermit": ["hermit-cli/**"],
    "hermit-install": ["hermit-install/**"]
  },
  "package_rules": [
    {
      "_why": "Shared Detcore/CLI code drives the non-Cargo strict and manifest harnesses.",
      "packages": [
        "hermit-detcore",
        "detcore-model",
        "detcore-testutils",
        "hermit",
        "hermit-test-workdir",
        "hermit-resources",
        "test-allocator"
      ],
      "nodes": [
        "e2e.manifest_applications_on_host",
        "e2e.manifest_bin_c_on_host",
        "e2e.manifest_c_programs_on_host",
        "e2e.manifest_chaos_c_on_host",
        "e2e.manifest_compat_on_host",
        "e2e.manifest_data_handling_on_host",
        "e2e.manifest_debugger_c_on_host",
        "e2e.manifest_determinism_stress_c_on_host",
        "e2e.manifest_determinism_stress_on_host",
        "e2e.manifest_language_runtimes_on_host",
        "e2e.manifest_shared_futex_c_on_host",
        "e2e.manifest_system_utils_on_host",
        "e2e.manifest_util_c_on_host",
        "test.applications_e2e",
        "test.envelope_levels"
      ],
      "e2e_all": true
    },
    {
      "_why": "hermit-install stages runtime resources used by every Hermit and backend test path.",
      "packages": ["hermit-install"],
      "nodes": [
        "e2e.manifest_applications_on_host",
        "e2e.manifest_bin_c_on_host",
        "e2e.manifest_c_programs_on_host",
        "e2e.manifest_chaos_c_on_host",
        "e2e.manifest_compat_on_host",
        "e2e.manifest_data_handling_on_host",
        "e2e.manifest_debugger_c_on_host",
        "e2e.manifest_determinism_stress_c_on_host",
        "e2e.manifest_determinism_stress_on_host",
        "e2e.manifest_language_runtimes_on_host",
        "e2e.manifest_shared_futex_c_on_host",
        "e2e.manifest_system_utils_on_host",
        "e2e.manifest_util_c_on_host",
        "test.applications_e2e",
        "test.app_strict_verify",
        "test.arbitrary_binaries",
        "test.cli_on_host",
        "test.command_strict_verify",
        "test.envelope_levels",
        "test.hermit_integration",
        "test.hermit_modes_on_host",
        "test.hermit_unit",
        "test.ignored_syscall_regressions",
        "test.liteinst_strict",
        "test.rr_suite_contract",
        "test.sabre_examples"
      ],
      "e2e_all": true
    },
    {
      "_why": "The shared guest crate and fixtures are consumed by Hermit integration tests and every manifest backend.",
      "packages": ["hermetic_infra_hermit_tests"],
      "nodes": [
        "e2e.manifest_applications_on_host",
        "e2e.manifest_bin_c_on_host",
        "e2e.manifest_c_programs_on_host",
        "e2e.manifest_chaos_c_on_host",
        "e2e.manifest_data_handling_on_host",
        "e2e.manifest_debugger_c_on_host",
        "e2e.manifest_determinism_stress_c_on_host",
        "e2e.manifest_determinism_stress_on_host",
        "e2e.manifest_language_runtimes_on_host",
        "e2e.manifest_shared_futex_c_on_host",
        "e2e.manifest_system_utils_on_host",
        "e2e.manifest_util_c_on_host",
        "test.applications_e2e",
        "test.app_strict_verify",
        "test.arbitrary_binaries",
        "test.cli_on_host",
        "test.command_strict_verify",
        "test.hermit_integration",
        "test.hermit_modes_on_host",
        "test.hermit_unit",
        "test.ignored_syscall_regressions",
        "test.rr_suite_contract"
      ],
      "e2e_all": true
    },
    {
      "_why": "The DBT plugin has a runtime-callback ABI check and DBT cells. The retired test.dbt_parity matrix's 28 cases are DBT cells of the c-programs and system-utils manifests since slice S13 of https://github.com/rrnewton/hermit/issues/3301, and check.dbt_runtime_abi lost the test.dbt_parity dependent that used to pull it in.",
      "packages": ["detcore-dbt"],
      "nodes": ["check.dbt_runtime_abi", "e2e.manifest_c_programs_on_host", "e2e.manifest_system_utils_on_host"],
      "e2e_backends": ["dbt"]
    },
    {
      "_why": "The SaBRe plugin has a backend-private release/examples harness and SaBRe cells.",
      "packages": ["detcore-sabre"],
      "nodes": ["test.sabre_examples"],
      "e2e_backends": ["sabre"]
    },
    {
      "_why": "Flaky guest binaries feed the chaos and determinism-stress manifest buckets.",
      "packages": ["hermetic_infra_hermit_flaky-tests"],
      "nodes": [
        "build.workspace",
        "e2e.manifest_chaos_c_on_host",
        "e2e.manifest_determinism_stress_on_host",
        "e2e.manifest_determinism_stress_c_on_host"
      ],
      "e2e_all": true
    }
  ],
  "path_footprints": [
    {
      "_why": "The e9patch preprocessing corpus and its manual driver moved out of tests/backend-parity in slice S13 of https://github.com/rrnewton/hermit/issues/3301. No validation lane has e9tool, so only the driver's contract test is selected.",
      "paths": ["tests/e9patch/**"],
      "nodes": ["check.e9patch_corpus"]
    },
    {
      "_why": "The identity-fixture mutation guard and the fixtures it plants into moved to tests/c when backend-parity-c was folded into c-programs (https://github.com/rrnewton/hermit/issues/3301).",
      "paths": ["tests/c/**"],
      "nodes": ["check.backend_parity_mutation"]
    },
    {
      "_why": "Shared non-Cargo guest fixtures are consumed by the manifest and Hermit integration harnesses.",
      "paths": [
        "examples/**",
        "tests/bin/**",
        "tests/c/**",
        "tests/chaos/**",
        "tests/compat/**",
        "tests/debugger/**",
        "tests/e2e/**",
        "tests/python/**",
        "tests/qemu-boot/**",
        "tests/reproducible-builds/**",
        "tests/runtime/**",
        "tests/rust/**",
        "tests/shared-futex-verify/**",
        "tests/shell/**",
        "tests/standalone/**",
        "tests/stress/**",
        "tests/util/**"
      ],
      "nodes": [
        "e2e.manifest_applications_on_host",
        "e2e.manifest_bin_c_on_host",
        "e2e.manifest_c_programs_on_host",
        "e2e.manifest_chaos_c_on_host",
        "e2e.manifest_data_handling_on_host",
        "e2e.manifest_debugger_c_on_host",
        "e2e.manifest_determinism_stress_c_on_host",
        "e2e.manifest_determinism_stress_on_host",
        "e2e.manifest_language_runtimes_on_host",
        "e2e.manifest_shared_futex_c_on_host",
        "e2e.manifest_system_utils_on_host",
        "e2e.manifest_util_c_on_host",
        "test.applications_e2e",
        "test.app_strict_verify",
        "test.arbitrary_binaries",
        "test.cli_on_host",
        "test.command_strict_verify",
        "test.hermit_integration",
        "test.hermit_modes_on_host",
        "test.hermit_unit",
        "test.ignored_syscall_regressions",
        "test.rr_suite_contract"
      ],
      "e2e_all": true
    },
    {
      "_why": "LiteInst runtime staging is outside Cargo's workspace graph.",
      "paths": ["scripts/stage-liteinst-runtime.sh"],
      "nodes": ["test.liteinst_strict"],
      "e2e_backends": ["liteinst"]
    },
    {
      "_why": "Standalone checks map to their own portable DAG node.",
      "paths": [
        ".agents/**",
        ".claude/**",
        ".llms/**",
        "CLAUDE.md",
        "scripts/check-skill-discovery.rs"
      ],
      "nodes": ["check.skill_discovery"]
    },
    {
      "_why": "Standalone checks map to their own portable DAG node.",
      "paths": ["scripts/check-detcore-backend-abstraction.sh"],
      "nodes": ["check.backend_abstraction"]
    },
    {
      "_why": "Standalone checks map to their own portable DAG node.",
      "paths": ["scripts/check-portable-paths.sh"],
      "nodes": ["check.portability_paths"]
    },
    {
      "_why": "Standalone checks map to their own portable DAG node.",
      "paths": ["scripts/check-dagrun-naming.sh"],
      "nodes": ["check.dagrun_naming"]
    }
  ]
}
