      "paths": ["hermit-cli/tests/app_strict_verify.rs"],
      "nodes": ["super.managed_jvm_strict_verify_diagnostics"]
    },
    {
      "_why": "Super nextest diagnostics select these hermit-cli test files by name; a test added there runs only in its super node.",
      "paths": ["hermit-cli/tests/ipc_determinism.rs"],
      "nodes": ["super.ipc_determinism_diagnostic"]
    },
    {
