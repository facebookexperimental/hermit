# Hermit's e2e manifest cells as Buck tests: one Tpx test per cell of
# ci/expected-e2e-plan.json, defined by the rules in defs.bzl and run by the
# cell runner (cell.sh). See README.md.
#
# The targets below build every input the cells read with Buck. fbsource's
# bundle uses them, and keeps the c-programs cells on the ptrace and kvm
# backends: fb-only/e2e_cells.bzl excludes every other category, backend and
# cell BY NAME, with its reason, and loading fails if the plan names one that
# file does not list either way. The open-source build's stand-in for that file
# (shim/hermetic_infra/hermit/fb-only/e2e_cells.bzl) keeps every cell and gives
# the bundle the inputs ./stage stages from a cargo build.
load(
    "@fbcode//hermetic_infra/hermit/fb-only:e2e_cells.bzl",
    "E2E_PLAN",
    "EXCLUDED_BACKENDS",
    "KEPT_CATEGORIES",
    "e2e_bundle_inputs",
    "kept_cells",
    "required_host_caps",
)
load("@fbcode_macros//build_defs:fbcode_configured_alias.bzl", "fbcode_configured_alias")
load("@fbcode_macros//build_defs:native_rules.bzl", "buck_genrule")
load(":defs.bzl", "hermit_e2e_bundle", "hermit_e2e_cells")
load(":re_exclusions.json", _RE_EXCLUSIONS = "value")

oncall("hermit")

# bin/: the harness and the planner it finds beside its own executable, under
# the names the cells call them by.
buck_genrule(
    name = "harness-bin",
    out = "bin",
    cmd = "mkdir -p $OUT && cp $(location //hermetic_infra/hermit/ci/manifest-plan:test-harness) $OUT/test-harness && cp $(location //hermetic_infra/hermit/ci/manifest-plan:hermit-manifest-plan) $OUT/hermit-manifest-plan",
)

# SOURCE_SHA: the upstream commit fbsource's tree was imported from. The cells
# record it as the source of src/, which is fbsource's copy of that commit. The
# open-source build records its checkout's commit instead (./stage).
buck_genrule(
    name = "source-sha",
    out = "SOURCE_SHA",
    cmd = "awk '$1 == \"rrnewton/hermit\" { print $2 }' $(location //hermetic_infra/hermit/fb-only:IMPORTED_SHA) > $OUT && grep -Eqx '[0-9a-f]{40}' $OUT",
    target_compatible_with = ["fbcode//opensource/macros:broken-in-oss"],
)

# src/: the source snapshot (//hermetic_infra/hermit:e2e-source-snapshot) as a
# plain directory, plus the paths upstream's test inventory names that fbsource
# does not carry: upstream's own tests/**/BUCK files (fbsource's BUCK files are
# its own, and the planner checks only that each inventoried path exists) and
# tests/debugger/.gitignore, which the snapshot's globs skip. The open-source
# build's bundle takes ./stage's src/ instead.
_UPSTREAM_TESTS_BUCK = [
    "tests/BUCK",
    "tests/bin/BUCK",
    "tests/c/BUCK",
    "tests/c/simple/BUCK",
    "tests/debugger/BUCK",
    "tests/debugger/guests/BUCK",
    "tests/runtime/BUCK",
    "tests/util/BUCK",
]

buck_genrule(
    name = "src",
    out = "src",
    cmd = " && ".join(
        [
            "cp -rL $(location //hermetic_infra/hermit:e2e-source-snapshot) $OUT",
            "chmod -R u+w $OUT",
            "cp $(location //hermetic_infra/hermit/tests/debugger:.gitignore) $OUT/tests/debugger/.gitignore",
        ]
        + [
            "echo '# Placeholder for the upstream Hermit file {}, which fbsource does not import (fbsource owns its BUCK files). The test inventory of the manifest planner requires the path; nothing reads it.' > $OUT/{}".format(
                path, path
            )
            for path in _UPSTREAM_TESTS_BUCK
        ]
    ),
    target_compatible_with = ["fbcode//opensource/macros:broken-in-oss"],
)

# build/: `test-harness build` for the kept cells, as ./stage runs it. It
# compiles the c-programs guests with the host's C compiler, so it runs locally
# (remote = False), like the local cells that run them. Its --source-sha comes
# from :source-sha, which only fbsource can build; the open-source build's
# bundle takes ./stage's build/ instead.
buck_genrule(
    name = "fixtures",
    out = "build",
    cmd = " ".join(
        [
            # The harness runs each compiler from the fixture's own directory, so
            # every root it is given is absolute.
            "mkdir -p $OUT $TMP/results && out=`realpath $OUT` && tmp=`realpath $TMP` &&",
            "E2E_BUILD_ROOT=$out E2E_RESULT_ROOT=$tmp/results E2E_RUN_ID=buck-fixtures VALIDATE_RUN_STATE=$tmp/run-state",
            "$(location :harness-bin)/test-harness build",
            "--repo-root $(location :src)",
            "--source-sha `cat $(location :source-sha)`",
            "--ci-only --lane portable",
        ]
        + ["--category " + c for c in KEPT_CATEGORIES]
        + ["--exclude-backend " + b for b in sorted(EXCLUDED_BACKENDS) if b != "in-guest-trap"]
    ),
    remote = False,
    target_compatible_with = ["fbcode//opensource/macros:broken-in-oss"],
)

# hermit/install/ and run-state/: empty. ptrace and kvm read no packaged
# resource (fb-only/e2e_cells.bzl EXCLUDED_BACKENDS), and no kept cell reads compat run state.
buck_genrule(
    name = "empty-install",
    out = "install",
    cmd = "mkdir -p $OUT",
)

buck_genrule(
    name = "empty-run-state",
    out = "run-state",
    cmd = "mkdir -p $OUT",
)

# hermit/hermit: Hermit built optimized whatever mode the cells are built in.
# The manifests' CPU budgets are calibrated on upstream's optimized release
# build; a dev-mode (unoptimized) Hermit spent about 4x the CPU and exceeded
# them in 3 of the 863 cells (chaos@ptrace of c-programs/ipc-determinism,
# thread-sync-determinism and fp-reduction-nondeterminism), which pass well
# inside them with an opt build.
fbcode_configured_alias(
    name = "hermit-opt",
    actual = "//hermetic_infra/hermit/hermit-cli:hermit",
    additional_constraints = ["ovr_config//build_mode/constraints:opt"],
    platform = "ovr_config//platform/linux:x86_64-fbcode",
)

# The bundle's inputs, by fb-only/e2e_cells.bzl: here the targets above; in the
# open-source build, what ./stage staged.
_INPUTS = e2e_bundle_inputs()

hermit_e2e_bundle(
    name = "bundle",
    src = _INPUTS["src"],
    fixtures = _INPUTS["fixtures"],
    harness_bin = _INPUTS["harness_bin"],
    hermit = _INPUTS["hermit"],
    install = _INPUTS["install"],
    recorder = "bundle-record",
    run_state = _INPUTS["run_state"],
    source_sha = _INPUTS["source_sha"],
)

hermit_e2e_cells(
    plan = {
        "cells": kept_cells(E2E_PLAN),
        "schema": E2E_PLAN["schema"],
    },
    re_exclusions = _RE_EXCLUSIONS,
    # The host capabilities whose absence fails a cell instead of skipping it,
    # by fb-only/e2e_cells.bzl: fbsource's CI hosts must give the kvm cells
    # /dev/kvm. The open-source build's stand-in requires none.
    require_host_caps_for = required_host_caps(),
)
