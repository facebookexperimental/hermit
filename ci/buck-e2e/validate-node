#!/bin/bash
# The validation DAG's two Buck runner nodes. e2e.buck_stage (--stage-only) stages the
# inputs Buck does not build; e2e.buck_cells (--cells-only) runs every e2e manifest cell
# under Buck against them and leaves the rows, unjudged, where the import twins
# (<bucket>_buck) read them. With no argument it does both, in order, as one process.
#
# usage: ci/buck-e2e/validate-node [--stage-only | --cells-only]
#        ci/buck-e2e/validate-node -h|--help
#
#   --stage-only  only ci/buck-e2e/stage --from-cargo: a cargo build in the checkout's
#                 target/ and a fresh ci/buck-e2e/staged/ for HEAD, whose SOURCE_SHA is
#                 written last. It needs none of the environment below, no buck2 and no
#                 runner; what it checks is what the stage checks: its host prerequisites,
#                 a clean tree of tracked files, and that every build and fixture step
#                 succeeds.
#   --cells-only  everything but the staging: regenerate the third-party rules, stage the
#                 RE link inputs for buck-hybrid, run the cells. It refuses with exit 2,
#                 before any step runs, unless ci/buck-e2e/staged/SOURCE_SHA exists and
#                 names HEAD, so it never runs cells against another commit's staging.
#
# scripts/validate.rs --e2e-runner buck-local|buck-hybrid --buck2 PATH selects both nodes
# and passes, through the environment (the cells, and the no-argument form, need it):
#   HERMIT_VALIDATE_E2E_RUNNER  buck-local (every cell locally) or buck-hybrid (RE-routed
#                               cells on Meta RE, the rest locally), or buck-stock (see
#                               below). Anything else, including cargo or unset, exits 2:
#                               nothing falls back.
#
# buck-stock (scripts/validate.rs --buck-s0 --buck2 PATH): a Buck-only run of one subset
# (HERMIT_VALIDATE_E2E_SUBSET, a ci/buck-e2e/subsets/*.json file) with the public buck2's
# stock test runner, in a checkout that needs no Cargo target directory. No cargo runs:
# --stage-only stages with ci/buck-e2e/stage --from-buck; --cells-only does not
# regenerate the third-party rules (Reindeer runs cargo metadata, so generating
# shim/third-party/rust/BUCK is the slot's setup, done once with
# bootstrap/regenerate-rust-deps, and this refuses without it, or when the stamp that
# script writes, shim/third-party/rust/BUCK.inputs, does not match this checkout's
# inputs: bootstrap/rust-deps-stamp.py check), runs the subset's
# shell-test twins (//ci/buck-e2e:stock-local, -c hermit_e2e.stock_runner=true, every cell
# on this host) and ingests their artifacts with ci/buck-e2e/ingest.py --local-listing.
# Its buck2 reads only this commit's tracked buckconfig, the buckconfig bundled into buck2,
# and ci/buck-e2e/stock-runner.buckconfig (the daemon's systemd scope, and no persisted
# dep-file cache). On a Meta host the internal buck wrapper rewrites
# ~/.buckconfig.d/experiments_from_buck_start from rollout state, and the public buck2 would
# load it. So in buck-stock, every form of this node, --stage-only included, exports two
# knobs for every buck2 it runs, its daemon included:
#   - BUCK2_TEST_SKIP_DEFAULT_EXTERNAL_CONFIG=1 skips /etc/buckconfig.d/*, /etc/buckconfig,
#     ~/.buckconfig.d/* and ~/.buckconfig.local;
#   - BUCK2_TEST_EXTRA_EXTERNAL_CONFIG adds stock-runner.buckconfig, which no other mode reads.
# Any other BUCK2_TEST_* variable refuses (exit 2).
# Right after exporting them, in every form, before any buck2 runs, it refuses a buck2
# settings file in HOME or at the checkout's root, and an untracked or linked
# .buckconfig.local or .buckconfig.d at the checkout's root (the shared action cache link of
# docs/BUCK2_OSS.md is one). An untracked config at another cell's root (shim/, say) is
# caught only by the per-value check below.
# The forms that run cells (no argument, --cells-only) also:
#   - write each machine-local file's sha256 to buck-invocations/buckconfig-external.tsv,
#     before the daemon starts;
#   - after the bounded daemon starts, write its buckconfig for every cell, with where each
#     value is defined, to buck-invocations/buckconfig-effective.txt;
#   - refuse before the stage or the cells unless that dump has values, every value comes
#     from a file of HEAD (inside a submodule, the submodule's HEAD, which must be the commit
#     HEAD records for it) with HEAD's bytes and no symlink on its path, from
#     the bundled prelude, or from stock-runner.buckconfig, and both of that file's keys are
#     defined there.
# --stage-only starts no bounded daemon, so its buckconfig gets the knobs and the refusal
# above but no dump or per-value check.
# ci/buck-e2e/buckconfig-sources.sh holds this code; ci/buck-e2e/test-buckconfig-sources.sh
# tests it.
# scripts/validate.rs --buck-s0 runs the no-argument form as ONE node, so the stage's buck2
# daemon is the cells' daemon: dagrun kills every process carrying a step's DAGRUN_STEP
# nonce when the step ends, the daemon included, so a daemon never outlives its node.
#   HERMIT_VALIDATE_AWAIT_PREFLIGHT  optional: the preflight nodes this node runs beside,
#                               in dependency order (--buck-s0: pre.submodules
#                               pre.reverie_pin). Before the first cell runs it waits for
#                               each one's exit status in
#                               $VALIDATE_RUN_STATE/preflight/<tag>.rc, which
#                               scripts/validate.rs --buck-s0 makes each preflight command
#                               write as it exits, and exits 1 on a nonzero status, or on
#                               none within HERMIT_VALIDATE_AWAIT_PREFLIGHT_SECONDS (a
#                               positive integer, required with it). So no cell runs on a
#                               tree the preflight refused, even under validate -k, where
#                               dagrun's fail-fast family does not cancel this node. The
#                               --buck-s0 DAG's first node, pre.buck_s0_records, removes an
#                               earlier execution's records before the preflight and this
#                               node start, so a reused run state's 0 cannot pass the wait.
#   HERMIT_VALIDATE_BUCK_DAEMON_MEMORY_MAX, HERMIT_VALIDATE_BUCK_DAEMON_CPU_SECONDS
#                               buck-stock only, required, positive integers (the DAG sets
#                               them). The buck2 daemon, and every cell it runs, lives in
#                               the daemon's own systemd scope (buck2.slice), outside this
#                               node's cgroup, so the node's box and CPU budget do not see
#                               them, and buck2 clears a test's environment, so no cell
#                               carries the node's DAGRUN_STEP and dagrun's reap misses
#                               them too. Before the stage this node stops any daemon
#                               already running for the checkout (exit 1 if that
#                               `buck2 kill` fails or times out), starts its own
#                               (`buck2 server --status`), sets the scope's MemoryMax to
#                               the first (systemctl --user set-property --runtime, read
#                               back from memory.max), and every 10 s compares the scope's
#                               CPU since then with the second: past it, or once the scope
#                               is gone while the node runs (the daemon was replaced by an
#                               unbounded one), it stops the daemon, kills its scope and
#                               sends this node SIGTERM. The node fails at its next command
#                               boundary (bash runs the trap when the foreground command
#                               returns; the killed daemon fails a running buck2 client)
#                               instead of starting an unbounded daemon with its next buck2
#                               command. A daemon with no systemd scope exits 2: it cannot
#                               be bounded.
#                               On every exit the scope's CPU and memory.peak are printed
#                               and kept in buck-invocations/daemon-scope.tsv. At every
#                               end (exit, signal, breach) `buck2 kill` is followed by the
#                               scope's cgroup.kill (systemctl --user kill as a fallback),
#                               so no cell outlives the node. ci/buck-e2e/daemon-bound.sh
#                               holds this code; ci/buck-e2e/test-daemon-bound.sh tests it.
#   HERMIT_VALIDATE_BUCK2       the absolute path of the internal buck2 (a DotSlash file),
#                               which is never committed.
#   VALIDATE_RUN_STATE          the run's state directory. The rows go to
#                               $VALIDATE_RUN_STATE/buck-e2e/results, Buck's event logs to
#                               $VALIDATE_RUN_STATE/buck-e2e/work.
#   E2E_RESULT_ROOT             the run's durable E2E result directory. The verify logs of
#                               every cell execution that did not pass go to
#                               $E2E_RESULT_ROOT/buck-failed-verify-logs (see
#                               ci/buck-e2e/ingest.py --failed-verify-logs), beside the
#                               rows the import twins publish; the state directory is not
#                               kept. Each `buck2 test` invocation's own record (its console
#                               log, exit status, test-run id, start and end time and event
#                               log: NAME.log, .rc, .test_id, .times, .event-log.pb.zst for
#                               NAME re, local, all and rerun-local, see ci/buck-e2e/run)
#                               goes to $E2E_RESULT_ROOT/buck-invocations on every exit of
#                               the cells, with NAME.stages.txt, where that invocation's
#                               cells spent their time (ci/buck-e2e/stages.py), and
#                               phases.tsv, the epoch time each step of this node began
#                               and the time and status it exited with (`exit N`), or the
#                               signal that ended it (`signal TERM`, INT or HUP), then
#                               `daemon stop` and `keeping records` as the signal path
#                               attempts each. Only
#                               records this attempt wrote are kept: an earlier attempt's
#                               are removed from the work directory before any step runs.
#                               Keeping them is best effort under a time budget (below);
#                               it never changes the node's status, and on a signal the
#                               node still dies of that signal.
# Optional: HERMIT_GIT_DEP_MIRRORS (see bootstrap/git-dep-mirrors.sh) serves Cargo.lock's
# git dependencies from local mirrors while the third-party rules are regenerated.
# HERMIT_VALIDATE_BUCK_RETENTION_SECONDS (default 30, a positive integer) bounds the copies
# and stage summaries made on exit; a node ended by a signal spends at most 2 seconds on
# them, within the scheduler's grace before it reaps the process group. Every command in
# that work runs under `timeout --foreground`, so it stays in the node's process group.
# HERMIT_VALIDATE_BUCK_STEP_WALL_SECONDS (a positive integer; the DAG sets it to
# e2e.buck_cells' wall bound) ends that work 10 seconds, kept for stopping the buck2
# daemon and exiting, before the bound that dagrun enforces from the step's start in
# DAGRUN_STEP_STARTED_MONOTONIC_NS, and skips it when that time has gone, so work that
# completed is never reported as a timeout. When it is set, the start must be a time on
# CLOCK_MONOTONIC that has passed, or the node exits 2. Bash cannot read CLOCK_MONOTONIC,
# so the node reads it once, with the wall clock, as it starts (python3, given 60 seconds
# because an interpreter can take seconds to start on a loaded host; a failed read exits
# 2 with its own message), and from then on counts down to the bound on the wall clock.
#
# Steps, all on the host, in the checkout: regenerate the Buck third-party rules
# (bootstrap/regenerate-rust-deps), stage the RE link inputs for buck-hybrid
# (shim/modes/stage-re-inputs), stage the inputs Buck does not build yet with a cargo
# build in the checkout's target/ (ci/buck-e2e/stage --from-cargo), then
# ci/buck-e2e/run --no-verdict with -c hermit_e2e.hermit=staged, so the cells test that
# cargo-built validate-profile target/validate/hermit, the payload a Cargo-runner run
# certifies. The stage builds in target/release, target/stage-hermit and target/validate.
# In the full plan it runs beside build.rust_scripts, which builds in
# target/ci/rust-script-build, and setup.manifest_plan, which builds in target/debug;
# Cargo locks each profile directory separately, so none of them waits on another. The
# other Cargo nodes build in the pinned root's own target. Whenever the cells run (the
# --cells-only and no-argument forms), the buck2 daemon is killed on every exit.
# Network steps run through with-proxy when it is installed.
#
# Exit status: 0 once the rows are written (or, for --stage-only, once the inputs are
# staged), whatever the cells' verdicts (the twins judge them); 2 for a usage error or a
# missing input; otherwise the failing step's status. A node sent TERM, INT or HUP while
# the cells run dies of that signal.
set -euo pipefail

usage() { sed -n '2,/^set -euo pipefail$/{/^set /d;s/^# \{0,1\}//;p}' "${BASH_SOURCE[0]}"; }
phase=all
case ${1:-} in
    -h|--help) usage; exit 0 ;;
    '') ;;
    --stage-only) phase=stage ;;
    --cells-only) phase=cells ;;
    *) echo "validate-node: unexpected argument: $1 (see --help)" >&2; exit 2 ;;
esac
if [[ $# -gt 1 ]]; then
    echo "validate-node: unexpected argument: $2 (see --help)" >&2
    exit 2
fi

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(cd "$here/../.." && pwd)
proxy=()
kept=
if command -v with-proxy >/dev/null 2>&1; then proxy=(with-proxy); fi
step() {
    echo "validate-node: $*" >&2
    [[ -z $kept ]] || printf '%s\t%s\n' "$(date -u +%s.%N)" "$*" >>"$kept/phases.tsv" || true
}
stage_inputs() {
    if [[ ${HERMIT_VALIDATE_E2E_RUNNER:-} == buck-stock ]]; then
        step "staging the subset's inputs with Buck (no cargo)"
        ./ci/buck-e2e/stage --from-buck "${HERMIT_VALIDATE_BUCK2:-}" --subset "${HERMIT_VALIDATE_E2E_SUBSET:-}"
        return
    fi
    step "staging the inputs Buck does not build (cargo, target/)"
    "${proxy[@]}" ./ci/buck-e2e/stage --from-cargo
}

# The preflight gate (HERMIT_VALIDATE_AWAIT_PREFLIGHT, above): wait for each named preflight
# node's exit status, in order; a failed or silent preflight ends this node before any cell.
await_preflight() {
    local tags=${HERMIT_VALIDATE_AWAIT_PREFLIGHT:-} bound=${HERMIT_VALIDATE_AWAIT_PREFLIGHT_SECONDS:-}
    local tag file status deadline
    [[ -n $tags ]] || return 0
    if [[ ! $bound =~ ^[1-9][0-9]{0,5}$ ]]; then
        echo "validate-node: HERMIT_VALIDATE_AWAIT_PREFLIGHT_SECONDS is '${bound}', not a positive number of seconds" >&2
        exit 2
    fi
    deadline=$((SECONDS + bound))
    for tag in $tags; do
        file=$VALIDATE_RUN_STATE/preflight/$tag.rc
        step "waiting for the preflight node $tag before any cell runs"
        until [[ -s $file ]]; do
            if ((SECONDS >= deadline)); then
                echo "validate-node: the preflight node $tag wrote no exit status to $file within $bound s; no cell runs on a tree the preflight has not passed" >&2
                exit 1
            fi
            sleep 1
        done
        status=$(<"$file")
        if [[ $status != 0 ]]; then
            echo "validate-node: the preflight node $tag failed (exit $status); no cell runs on a tree the preflight refused" >&2
            exit 1
        fi
    done
    step "the preflight passed: $tags"
}

# buck-stock's buckconfig (above): the knobs and the untracked-config refusal come before
# any buck2 this node runs, in every form, --stage-only included.
# shellcheck source-path=SCRIPTDIR source=buckconfig-sources.sh
source "$here/buckconfig-sources.sh"
# What this node's Buck work costs (B0): where the daemon ran (and, in its systemd scope, its CPU
# and memory), every action's execution kind, the bootstraps' CPU, which buck2 ran. Record only:
# a failed measurement costs the sidecar ($E2E_RESULT_ROOT/buck-measure/<DAG step tag>.json),
# never the node, and it adds no `buck2 kill` and no extra `buck2 log show`. --stage-only runs no
# buck2 under buck-local and buck-hybrid, the only runners whose DAG has a separate stage node,
# so it measures nothing.
# shellcheck source-path=SCRIPTDIR source=buck-measure.sh
source "$here/buck-measure.sh"
if [[ ${HERMIT_VALIDATE_E2E_RUNNER:-} == buck-stock ]]; then
    export_stock_buckconfig_env
    refuse_untracked_buck_config
fi

if [[ $phase == stage ]]; then
    cd "$root"
    stage_inputs
    exit 0
fi
if [[ $phase == cells ]]; then
    staged_sha_file=$here/staged/SOURCE_SHA
    if ! head_sha=$(git -C "$root" rev-parse HEAD 2>/dev/null); then
        echo "validate-node: --cells-only cannot read HEAD in $root to check the staged inputs against it" >&2
        exit 2
    fi
    if [[ ! -s $staged_sha_file ]]; then
        echo "validate-node: --cells-only needs staged inputs, and $staged_sha_file is missing: the stage (e2e.buck_stage, ci/buck-e2e/validate-node --stage-only) did not finish" >&2
        exit 2
    fi
    staged_sha=$(<"$staged_sha_file")
    if [[ $staged_sha != "$head_sha" ]]; then
        echo "validate-node: --cells-only refuses: the inputs were staged for $staged_sha, but HEAD is $head_sha; stage again (ci/buck-e2e/validate-node --stage-only)" >&2
        exit 2
    fi
fi

runner=${HERMIT_VALIDATE_E2E_RUNNER:-}
# Each mode names its Buck mode file. buck-local needs shim/modes/meta-local, not the bare
# .buckconfig: the Meta buck2 the validation host runs refuses `buck2 test` without
# test.v2_test_executor ("Cannot use internal test runner. Config value must be provided
# for test.v2_test_executor"), and ci/buck-e2e/ingest.py reads the results through TestX
# either way. With no mode file, e2e.buck_cells in buck-local failed 9 s after it started
# (validate-claude-coord-685023149cde-1792253229043517790-2205237-22189032).
case $runner in
    buck-local) mode=local; buck_args=(@shim/modes/meta-local) ;;
    buck-hybrid) mode=hybrid; buck_args=(@shim/modes/hybrid) ;;
    buck-stock) mode=stock; buck_args=() ;;
    *)
        echo "validate-node: HERMIT_VALIDATE_E2E_RUNNER is '${runner}', not buck-local, buck-hybrid or buck-stock; run scripts/validate.rs --e2e-runner buck-local|buck-hybrid --buck2 PATH or --buck-s0 --buck2 PATH" >&2
        exit 2 ;;
esac
buck2=${HERMIT_VALIDATE_BUCK2:-}
if [[ $buck2 != /* || ! -f $buck2 || ! -x $buck2 ]]; then
    echo "validate-node: HERMIT_VALIDATE_BUCK2 is '${buck2}', not an absolute path to an executable file; pass scripts/validate.rs --buck2 PATH" >&2
    exit 2
fi
subset=
daemon_memory_max='' daemon_cpu_seconds=''
if [[ $mode == stock ]]; then
    subset=${HERMIT_VALIDATE_E2E_SUBSET:-}
    if [[ $subset != /* || ! -f $subset ]]; then
        echo "validate-node: HERMIT_VALIDATE_E2E_SUBSET is '${subset}', not the absolute path of a subset file (ci/buck-e2e/subsets/*.json)" >&2
        exit 2
    fi
    daemon_memory_max=${HERMIT_VALIDATE_BUCK_DAEMON_MEMORY_MAX:-}
    daemon_cpu_seconds=${HERMIT_VALIDATE_BUCK_DAEMON_CPU_SECONDS:-}
    if [[ ! $daemon_memory_max =~ ^[1-9][0-9]{0,15}$ || ! $daemon_cpu_seconds =~ ^[1-9][0-9]{0,7}$ ]]; then
        echo "validate-node: buck-stock bounds the buck2 daemon's scope, and HERMIT_VALIDATE_BUCK_DAEMON_MEMORY_MAX is '${daemon_memory_max}' and HERMIT_VALIDATE_BUCK_DAEMON_CPU_SECONDS '${daemon_cpu_seconds}', not two positive integers (bytes, CPU seconds)" >&2
        exit 2
    fi
fi
if [[ -z ${VALIDATE_RUN_STATE:-} ]]; then
    echo "validate-node: VALIDATE_RUN_STATE is unset; this node runs under scripts/validate.rs" >&2
    exit 2
fi
if [[ -z ${E2E_RESULT_ROOT:-} ]]; then
    echo "validate-node: E2E_RESULT_ROOT is unset; this node runs under scripts/validate.rs" >&2
    exit 2
fi
retention_seconds=${HERMIT_VALIDATE_BUCK_RETENTION_SECONDS:-30}
if [[ ! $retention_seconds =~ ^[1-9][0-9]{0,5}$ ]]; then
    echo "validate-node: HERMIT_VALIDATE_BUCK_RETENTION_SECONDS is '${retention_seconds}', not a positive number of seconds" >&2
    exit 2
fi
# dagrun exports when this step started, but not its wall bound; the DAG passes the bound.
step_wall_seconds=${HERMIT_VALIDATE_BUCK_STEP_WALL_SECONDS:-}
step_started_ns=${DAGRUN_STEP_STARTED_MONOTONIC_NS:-}
step_reserve_seconds=10
step_end_us= # the epoch microseconds of this step's wall bound, less the reserve
if [[ -n $step_wall_seconds ]]; then
    if [[ ! $step_wall_seconds =~ ^[1-9][0-9]{0,5}$ ]]; then
        echo "validate-node: HERMIT_VALIDATE_BUCK_STEP_WALL_SECONDS is '${step_wall_seconds}', not a positive number of seconds" >&2
        exit 2
    fi
    if [[ ! $step_started_ns =~ ^[0-9]{1,18}$ ]]; then
        echo "validate-node: HERMIT_VALIDATE_BUCK_STEP_WALL_SECONDS is set, but DAGRUN_STEP_STARTED_MONOTONIC_NS is '${step_started_ns}', not a time on CLOCK_MONOTONIC that has passed" >&2
        exit 2
    fi
    # One reading of both clocks, so the time python3 takes to start is in neither.
    clocks_status=0
    clocks=$(timeout --foreground -k 1 60 python3 -c 'import time; print(time.monotonic_ns(), time.time_ns())') ||
        clocks_status=$?
    if ((clocks_status != 0)) || [[ ! $clocks =~ ^([0-9]{1,18})\ ([0-9]{1,19})$ ]]; then
        echo "validate-node: HERMIT_VALIDATE_BUCK_STEP_WALL_SECONDS is set, but CLOCK_MONOTONIC could not be read: python3 exited ${clocks_status} within 60 s and printed '${clocks}', not two clock readings" >&2
        exit 2
    fi
    if ((BASH_REMATCH[1] < step_started_ns)); then
        echo "validate-node: HERMIT_VALIDATE_BUCK_STEP_WALL_SECONDS is set, but DAGRUN_STEP_STARTED_MONOTONIC_NS is '${step_started_ns}', not a time on CLOCK_MONOTONIC that has passed" >&2
        exit 2
    fi
    step_end_us=$(((BASH_REMATCH[2] + step_started_ns + step_wall_seconds * 1000000000 - BASH_REMATCH[1]) / 1000 - step_reserve_seconds * 1000000))
fi
state=$VALIDATE_RUN_STATE/buck-e2e
failed_logs=$(realpath -m -- "$E2E_RESULT_ROOT")/buck-failed-verify-logs
invocations=$(realpath -m -- "$E2E_RESULT_ROOT")/buck-invocations

# The invocations' records are evidence, not input, like the failed cells' logs: an earlier
# attempt's copy that cannot be replaced costs this run its copy, never the run, and so does
# any copy or summary that fails below.
if rm -rf -- "${invocations:?}" && mkdir -p -- "$invocations"; then
    kept=$invocations
else
    echo "validate-node: cannot replace the earlier $invocations (above); this run keeps no Buck invocation records" >&2
fi
# ci/buck-e2e/run removes an earlier attempt's records from $state/work only once it starts;
# a step that fails before then must not leave them to be kept as this attempt's.
if [[ -n $kept ]] && ! rm -f -- "$state/work"/{re,local,all,rerun-local,stock}.{log,rc,test_id,times,event-log.pb.zst}; then
    echo "validate-node: cannot remove an earlier attempt's Buck invocation records from $state/work (above); this run keeps none" >&2
    kept=
fi
measure_left() { # $1: a cap (seconds); $2: how many seconds of the stop reserve the measurement may
    # use. Set left to the cap, or to the time until the step's wall bound less the rest of the
    # reserve if that is sooner; fail once none is left. Without a wall bound, the cap alone.
    local cap_us=$(($1 * 1000000)) now=${EPOCHREALTIME/[^0-9]/} room
    if [[ -n $step_wall_seconds ]]; then
        room=$((step_end_us + $2 * 1000000 - now))
        ((room > 0)) || return 1
        if ((room < cap_us)); then
            cap_us=$room
        fi
    fi
    printf -v left '%d.%06d' $((cap_us / 1000000)) $((cap_us % 1000000))
}
time_left() { # set left to the seconds until the caller's deadline (epoch microseconds); fail once it has passed
    local now=${EPOCHREALTIME/[^0-9]/}
    ((now < deadline)) || return 1
    printf -v left '%d.%06d' $(((deadline - now) / 1000000)) $(((deadline - now) % 1000000))
}
keep_invocations() { # $1: a deadline (epoch microseconds); $2: what set it. Copy each invocation's
    # record from $state/work into $kept, with its stage summary. Each command gets what is left
    # before $1 and none starts after it, so a stalled copy or summary costs records, never the
    # node's status or its daemon cleanup.
    # The decoded stream is also teed to the measurement's work directory, where the sidecar counts
    # its actions and then deletes it: it duplicates the kept .event-log.pb.zst, so it is not kept.
    # Every invocation that kept an event log owes the sidecar one whole decoded copy, whether or
    # not the time below reaches it, so a partial count is never written.
    local deadline=$1 left name file decoded
    bm_expected_event_logs=0 bm_event_logs=()
    for name in re local all rerun-local stock; do
        if [[ -f $state/work/$name.event-log.pb.zst ]]; then
            bm_expected_event_logs=$((bm_expected_event_logs+1))
        fi
    done
    for name in re local all rerun-local stock; do
        for file in "$state/work/$name".{log,rc,test_id,times,event-log.pb.zst}; do
            [[ -f $file ]] || continue
            if ! time_left; then
                echo "validate-node: $2 ran out before $file" >&2
                return
            fi
            timeout --foreground -k 0.5 "$left" cp -- "$file" "$kept/"
        done
        [[ -f $state/work/$name.event-log.pb.zst ]] || continue
        decoded=/dev/null
        if [[ -n $bm_work ]]; then
            decoded=$bm_work/$name.event-log.jsonl
            bm_event_logs+=("$decoded")
        fi
        if ! time_left; then
            echo "validate-node: $2 ran out before the $name invocation's stage summary" >&2
            return
        fi
        if ! timeout --foreground -k 0.5 "$left" "$buck2" log show "$state/work/$name.event-log.pb.zst" |
            timeout --foreground -k 0.5 "$left" tee -- "$decoded" |
            timeout --foreground -k 0.5 "$left" python3 "$here/stages.py" - >"$kept/$name.stages.txt"; then
            echo "validate-node: the stage summary of the $name invocation is incomplete (above)" >&2
        fi
    done
}
# The buck2 daemon's bound (HERMIT_VALIDATE_BUCK_DAEMON_*, above): bound_daemon before the
# stage; record_daemon, then `buck2 kill`, then kill_daemon_scope at every end.
# shellcheck source-path=SCRIPTDIR source=daemon-bound.sh
source "$here/daemon-bound.sh"
exiting=
on_exit() { # keep the invocations' records, then stop the buck2 daemon; the node's status stands
    local status=$?
    set +e
    exiting=1
    if [[ -n $kept ]]; then
        printf '%s\texit %s\n' "$(date -u +%s.%N)" "$status" >>"$kept/phases.tsv"
        local now deadline why
        now=${EPOCHREALTIME/[^0-9]/}
        deadline=$((now + retention_seconds * 1000000))
        why="the $retention_seconds s for keeping the Buck invocation records"
        if [[ -n $step_wall_seconds ]] && ((step_end_us < deadline)); then
            deadline=$step_end_us
            why="the time left before this step's $step_wall_seconds s wall bound, less $step_reserve_seconds s for stopping buck2,"
        fi
        keep_invocations "$deadline" "$why"
    fi
    # The measurement reads where the daemon runs while it still runs, and writes the sidecar once
    # it is stopped, each within what is left of this step's wall bound (measure_left).
    local left
    if [[ -n $bm_work ]] && measure_left 5 2; then
        buck_measure_daemon "$left"
    fi
    record_daemon
    "$buck2" kill >/dev/null 2>&1
    kill_daemon_scope
    if [[ -n $bm_work ]]; then
        if measure_left "$retention_seconds" $((step_reserve_seconds - 2)); then
            buck_measure_write "$left"
        else
            echo "validate-node: no time was left before this step's wall bound to write the Buck measurement; this node has no sidecar, which the comparison refuses" >&2
            buck_measure_discard
        fi
    fi
    if [[ -n $daemon_breach && -s $daemon_breach ]]; then
        echo "validate-node: fails: $(<"$daemon_breach")" >&2
        ((status != 0)) || exit 1
    fi
}
on_signal() { # $1: the signal. Record it, stop the buck2 daemon, keep what records fit in
    # 2 seconds (none if the exit had begun keeping them), then die of $1 as if it were not
    # caught. The daemon stops FIRST: the DAG reaps the group 5 s after its SIGTERM, and the
    # record keeping below may spend that whole window under load, which once left the daemon
    # running and its stop unrecorded (dh-6aaks).
    # Bash runs this once the foreground command returns; on an uncaught signal its EXIT trap
    # would see that command's status and record a signal as an ordinary exit.
    trap - EXIT
    set +e
    record_daemon
    if [[ -n $kept ]]; then
        printf '%s\tsignal %s\n' "$(date -u +%s.%N)" "$1" >>"$kept/phases.tsv"
        # The stop is recorded as it is ATTEMPTED, before `buck2 kill` runs: the order "daemon
        # stop" before "keeping records" then holds on record even when a loaded host cuts the kill
        # off at its 1 s bound.
        printf '%s\tdaemon stop\n' "$(date -u +%s.%N)" >>"$kept/phases.tsv"
    fi
    timeout --foreground -k 0.5 1 "$buck2" kill >/dev/null 2>&1
    kill_daemon_scope
    if [[ -n $daemon_breach && -s $daemon_breach ]]; then
        echo "validate-node: fails: $(<"$daemon_breach")" >&2
    fi
    if [[ -n $kept && -z $exiting ]]; then
        printf '%s\tkeeping records\n' "$(date -u +%s.%N)" >>"$kept/phases.tsv"
        keep_invocations $((${EPOCHREALTIME/[^0-9]/} + 2000000)) "the 2 s a signalled node keeps for the Buck invocation records"
    fi
    # A signalled node writes no sidecar: remove the measurement's work directory, with the decoded
    # event-log copies keep_invocations teed into it, instead of leaving it in $TMPDIR.
    buck_measure_discard
    trap - "$1"
    kill -s "$1" "$$"
}

cd "$root"
trap on_exit EXIT
trap 'on_signal TERM' TERM
trap 'on_signal INT' INT
trap 'on_signal HUP' HUP

# The sidecar is named by the DAG step this invocation is (DAGRUN_OUTER_RUN); the name given here
# is used only outside dagrun.
buck_measure_start "e2e.buck_$phase" "$buck2" HERMIT_VALIDATE_BUCK2
if [[ $mode == stock ]]; then
    if [[ ! -s shim/third-party/rust/BUCK ]]; then
        echo "validate-node: buck-stock runs no cargo, so it does not generate the third-party rules; shim/third-party/rust/BUCK is missing: generate it once in this checkout with bootstrap/regenerate-rust-deps (slot setup)" >&2
        exit 2
    fi
    # Generated for this checkout's inputs, or refused: rules generated for another
    # Cargo.lock would build another commit's crates under this commit's SOURCE_SHA.
    if ! python3 ./bootstrap/rust-deps-stamp.py check "$root"; then
        echo "validate-node: shim/third-party/rust/BUCK was not generated from this checkout's inputs (above): regenerate it once with bootstrap/regenerate-rust-deps (slot setup)" >&2
        exit 2
    fi
    step "using the third-party rules already generated in this checkout for its inputs (sha256 $(sha256sum shim/third-party/rust/BUCK | cut -c1-16))"
else
    step "regenerating the Buck third-party rules"
    buck_measure_bootstrap regenerate-rust-deps "${proxy[@]}" ./bootstrap/regenerate-rust-deps
fi
if [[ $mode == stock ]]; then
    config_records=${kept:-$state/work}
    mkdir -p -- "$config_records"
    record_external_buckconfigs >"$config_records/buckconfig-external.tsv"
    step "buck2 skips the machine-local buckconfigs; their sha256 are in $config_records/buckconfig-external.tsv"
    bound_daemon
    buck_measure_scope "$daemon_scope"
    check_buckconfig_sources "$config_records/buckconfig-effective.txt" "$config_records/buckconfig-external.tsv"
fi
if [[ $mode == hybrid ]]; then
    step "staging the RE link inputs"
    "${proxy[@]}" ./shim/modes/stage-re-inputs
fi
if [[ $phase == all ]]; then
    stage_inputs
fi
await_preflight
rm -rf -- "${state:?}/results"
# The failed cells' logs are evidence, not input: an earlier attempt's copy that cannot be
# removed costs this run its copy, never the run.
failed_logs_args=(--failed-verify-logs "$failed_logs")
if ! rm -rf -- "${failed_logs:?}"; then
    echo "validate-node: cannot remove the earlier $failed_logs (above); this run keeps no failed-cell verify logs" >&2
    failed_logs_args=()
fi
mkdir -p "$state/work"
# Every cell of the run gets one HERMIT_EPOCH: backend parity compares a ptrace reference with
# its candidates only when they share the guest epoch, and each cell is its own harness
# process, which would otherwise sample its own start time. The epoch is derived from the
# inputs, the checked-out commit's committer time, not sampled: it is part of every cell's
# action digest, so a sample would keep any cell result from being reused, while this keeps
# a re-validation of the same commit cacheable and its runs reproducible. An exported
# HERMIT_EPOCH overrides it.
if [[ -n ${HERMIT_EPOCH:-} ]]; then
    epoch=$HERMIT_EPOCH
elif committed=$(git -C "$root" show -s --format=%ct HEAD) && [[ $committed =~ ^[0-9]+$ ]]; then
    epoch=$(date -u -d "@$committed" +%Y-%m-%dT%H:%M:%S+00:00)
else
    echo "validate-node: cannot read the checked-out commit's committer time for HERMIT_EPOCH; export HERMIT_EPOCH to supply one" >&2
    exit 2
fi
if [[ $mode == stock ]]; then
    # The cells' artifact root is in the run's state directory inside the checkout, never
    # under host /tmp: Hermit gives a guest its own /tmp, so a guest program staged under
    # host /tmp is refused. A fresh root per run, so the listing holds this run alone.
    stock_root=$state/stock-execution
    rm -rf -- "${stock_root:?}"
    mkdir -p "$stock_root"
    # Read whole, so a refusing subset.py stops the node under set -e (a process
    # substitution would drop its status). ingest.py below refuses unless the cells Buck ran
    # are exactly the subset plan's, none missing and none more, so the -c flags that define
    # the subset in Buck (ci/buck-e2e/subset.bzl) and subset.py cannot silently disagree.
    python3 ./ci/buck-e2e/subset.py "$subset" ci/expected-e2e-plan.json plan "$state/subset-plan.json" >/dev/null
    subset_counts=$(python3 ./ci/buck-e2e/subset.py "$subset" ci/expected-e2e-plan.json counts)
    subset_config=$(python3 ./ci/buck-e2e/subset.py "$subset" ci/expected-e2e-plan.json buck-config)
    mapfile -t subset_flags <<<"$subset_config"
    step "subset $subset_counts"
    step "running the $(basename "$subset") cells under the stock buck2 test runner, HERMIT_EPOCH=$epoch"
    date +%s >"$state/work/stock.times"
    stock_status=0
    "$buck2" test -c hermit_release.unstamped=true "${subset_flags[@]}" -c hermit_e2e.stock_runner=true \
        -c hermit_e2e.routing=local -c "hermit_e2e.epoch=$epoch" -c "hermit_e2e.stock_artifact_root=$stock_root" \
        --no-remote-cache --event-log "$state/work/stock.event-log.pb.zst" //ci/buck-e2e:stock-local \
        >"$state/work/stock.log" 2>&1 || stock_status=$?
    date +%s >>"$state/work/stock.times"
    echo "$stock_status" >"$state/work/stock.rc"
    # buck2 test exits 32 when tests fail: the verdicts are the rows', not the exit code.
    if ((stock_status != 0 && stock_status != 32)); then
        echo "validate-node: buck2 test failed with exit $stock_status; see $state/work/stock.log" >&2
        exit 1
    fi
    step "ingesting the cells' artifacts"
    python3 ./ci/buck-e2e/ingest.py --plan "$state/subset-plan.json" --out "$state/results" \
        --local-artifacts "$stock_root" --local-listing "${failed_logs_args[@]}"
else
    step "running every cell under Buck ($runner), HERMIT_EPOCH=$epoch"
    ./ci/buck-e2e/run --mode "$mode" --no-verdict --out "$state/results" --work "$state/work" \
        "${failed_logs_args[@]}" \
        --buck2 "$buck2" -- "${buck_args[@]}" -c hermit_e2e.hermit=staged -c "hermit_e2e.epoch=$epoch"
fi
