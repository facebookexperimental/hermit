load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("hermit")

# Hermit's plain ptrace run and the root of its Detcore instantiation,
# compiled apart from the hermit library so it builds in parallel.
rust_library(
    name = "hermit-run-ptrace",
    srcs = glob(["src/**/*.rs"]),
    autocargo = {"cargo_toml_dir": "."},
    deps = [
        "//hermetic_infra/hermit/detcore:detcore",
        "//hermetic_infra/reverie:reverie",
        "//hermetic_infra/reverie:reverie-ptrace",
    ],
)
