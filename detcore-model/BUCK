load("@fbcode//hermetic_infra/reverie/constraints:liteinst-runtime-flags.bzl", "LITEINST_RUNTIME_FLAGS_CONSTRAINT", "LITEINST_RUNTIME_SELECT_RUSTC_FLAGS")
load("@fbcode_macros//build_defs:export_files.bzl", "buck_export_file")
load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("hermit")

rust_library(
    name = "detcore-model",
    srcs = glob(["src/**/*"]),
    autocargo = {
        "cargo_toml_config": {
            # Upstream's features, declared but empty so `cfg(feature = ...)`
            # stays known to the fbsource Cargo check.
            "features": {
                "native-exec": [],
            },
        },
    },
    named_deps = {"reverie": "//hermetic_infra/reverie:reverie"},
    rustc_flags = select({
        "DEFAULT": [],
        LITEINST_RUNTIME_FLAGS_CONSTRAINT: LITEINST_RUNTIME_SELECT_RUSTC_FLAGS,
    }),
    # x86-64 only until the aarch64 port's arch-aware syscall histogram
    # lands: src/syscall_histogram.rs labels every table
    # ARCHITECTURE = "x86_64", malformation() refuses any other architecture,
    # and its tests use x86-64 syscall numbers. (detcore's CPUID cause does
    # not apply to this crate.) The targets that depend on this crate carry
    # their own pin naming this cause, so aarch64 skips them instead of
    # failing on an incompatible dependency.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    test_deps = [
        "fbsource//third-party/rust:pretty_assertions",
    ],
    deps = [
        "fbsource//third-party/rust:anyhow",
        "fbsource//third-party/rust:bincode",
        "fbsource//third-party/rust:bitvec",
        "fbsource//third-party/rust:bytesize",
        "fbsource//third-party/rust:chrono",
        "fbsource//third-party/rust:clap",
        "fbsource//third-party/rust:libc",
        "fbsource//third-party/rust:nix",
        "fbsource//third-party/rust:serde",
        "fbsource//third-party/rust:serde_json",
        "fbsource//third-party/rust:shell-words",
        "fbsource//third-party/rust:tracing",
        "//hermetic_infra/reverie:reverie-proc-grammar",
        "//hermetic_infra/reverie:reverie-syscalls",
    ],
)

# Included verbatim by scripts/lib/validate_plan.rs, which the e2e test harness
# (ci/manifest-plan) includes by #[path].
buck_export_file(
    name = "canonical_test_epoch.rs",
    src = "src/canonical_test_epoch.rs",
    visibility = ["//hermetic_infra/hermit/ci/manifest-plan:"],
)

# This package's Cargo manifest, for the tree check.backend_abstraction runs
# on (//hermetic_infra/hermit:backend-abstraction-repository).
buck_export_file(
    name = "Cargo.toml",
    visibility = ["//hermetic_infra/hermit:"],
)
