# @lint-ignore-every AUTODEPS2
# These repository maintenance scripts are not part of the fbsource Buck graph,
# except the unchanged sources that fb-only/contract_checks builds and runs and
# the validation-plan sources that the ci/manifest-plan library maps.

load("@fbcode_macros//build_defs:export_files.bzl", "buck_export_file")

oncall("hermit")

# check.exit_status_class: the rust-script and the module it includes by #[path].
[
    buck_export_file(
        name = src,
        visibility = ["//hermetic_infra/hermit/fb-only/contract_checks:"],
    )
    for src in [
        "check-exit-status-class.rs",
        "lib/rust_script_prelude.rs",
    ]
]

# Tier 2 Cargo.lock co-change: the rust-script
# fb-only/contract_checks builds unchanged and runs in --check-tree
# mode over the declared manifest/lock snapshot.
buck_export_file(
    name = "check-cargo-lock-cochange.rs",
    visibility = ["//hermetic_infra/hermit/fb-only/contract_checks:"],
)

# check.no_v3: the rust-script fb-only/contract_checks builds and runs
# nightly over the Buck-built hermit binary.
buck_export_file(
    name = "check-no-v3.rs",
    visibility = ["//hermetic_infra/hermit/fb-only/contract_checks:"],
)

buck_export_file(
    name = "check-no-v3-allowlist.txt",
    visibility = ["//hermetic_infra/hermit/fb-only/contract_checks:"],
)

# check.syscall_pages: the per-syscall pages tool, built unchanged by
# fb-only/contract_checks and run in two tiers (`check --committed`
# hard, `check --quick` soft drift) over declared tree snapshots.
buck_export_file(
    name = "syscall-pages.rs",
    visibility = ["//hermetic_infra/hermit/fb-only/contract_checks:"],
)

# check.backend_abstraction: the script and the source gate it executes.
[
    buck_export_file(
        name = src,
        visibility = [
            "//hermetic_infra/hermit:",
            "//hermetic_infra/hermit/fb-only/contract_checks:",
        ],
    )
    for src in [
        "check-detcore-backend-abstraction.sh",
        "detcore-backend-source.rs",
    ]
]

# scripts/lib sources the e2e test harness (ci/manifest-plan) includes by #[path].
[
    buck_export_file(
        name = name,
        src = "lib/" + name,
        visibility = ["//hermetic_infra/hermit/ci/manifest-plan:"],
    )
    for name in [
        "validate_corpus.rs",
        "validate_generator.rs",
        "validate_plan.rs",
        "validate_super.rs",
    ]
]
