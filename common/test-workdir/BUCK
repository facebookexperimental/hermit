load("@fbcode_macros//build_defs:export_files.bzl", "buck_export_file")
load("@fbsource//tools/build_defs:rust_binary.bzl", "rust_binary")
load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("hermit")

rust_library(
    name = "hermit-test-workdir",
    srcs = ["src/lib.rs"],
    autocargo = {
        "cargo_toml_config": {
            "bin": [
                {
                    "name": "workdir-control",
                    "path": "src/bin/workdir-control.rs",
                }
            ],
            "package": {"publish": False},
        },
        "cargo_toml_dir": ".",
    },
    deps = ["fbsource//third-party/rust:libc"],
)

rust_binary(
    name = "workdir-control",
    srcs = ["src/bin/workdir-control.rs"],
    # Autocargo normalizes generated binary names; the library supplies the
    # Cargo bin entry to preserve this executable's hyphenated name.
    autocargo = {"ignore_rule": True},
    crate_root = "src/bin/workdir-control.rs",
    deps = [
        "fbsource//third-party/rust:libc",
        ":hermit-test-workdir",
    ],
)

# This package's Cargo manifest, for the tree check.backend_abstraction runs
# on (//hermetic_infra/hermit:backend-abstraction-repository).
buck_export_file(
    name = "Cargo.toml",
    visibility = ["//hermetic_infra/hermit:"],
)
