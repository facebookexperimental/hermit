# Dual-mode build configuration, modelled on the buck2 repository's own
# arrangement: the BUCK files in this tree are the ones Meta builds internally,
# and the `shim` cell supplies open-source definitions for the cells those
# files load from.

[cells]
hermit = .
reverie = reverie
gh_facebook_buck2_shims_meta = shim
reverie_shim = shim
prelude = prelude
none = none

[cell_aliases]
root = hermit
config = prelude
ovr_config = prelude
bazel_skylib = gh_facebook_buck2_shims_meta
buck = gh_facebook_buck2_shims_meta
fbcode = gh_facebook_buck2_shims_meta
fbcode_macros = gh_facebook_buck2_shims_meta
fbsource = gh_facebook_buck2_shims_meta
shim = gh_facebook_buck2_shims_meta
toolchains = gh_facebook_buck2_shims_meta

[external_cells]
prelude = bundled

[build]
execution_platforms = prelude//platforms:default

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default target:shim//...->prelude//platforms:default target:reverie//...->prelude//platforms:default target:reverie_shim//...->prelude//platforms:default

[oss]
internal_cell = fbcode
stripped_root_dirs = hermetic_infra/hermit
prefix_mappings = fbcode//hermetic_infra/reverie->reverie// fbcode//common/rust/build_info->gh_facebook_buck2_shims_meta//common/rust/build_info

[rust]
default_edition = 2024

[buck2]
forkserver = false
file_watcher = notify

[project]
ignore = .git, target, shim/third-party/rust/vendor
