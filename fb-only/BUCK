load("@fbcode//fbpkg:fbpkg.bzl", "fbpkg")

oncall("hermit")

fbpkg.builder(
    name = "hermetic_infra.hermit_cli",
    architectures = ["x86_64"],
    path_actions = {
        "hermit": "//hermetic_infra/hermit/hermit-cli:hermit",
        "install.toml": "install.toml",
    },
    # hermit is x86-64 only (detcore virtualizes the x86 cpuid instruction).
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)
