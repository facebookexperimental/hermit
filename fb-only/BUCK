load("@fbcode//fbpkg:fbpkg.bzl", "fbpkg")
load("@fbcode_macros//build_defs:export_files.bzl", "buck_export_file")

oncall("hermit")

fbpkg.builder(
    name = "hermetic_infra.hermit_cli",
    architectures = ["x86_64"],
    path_actions = {
        "hermit": "//hermetic_infra/hermit/hermit-cli:hermit",
        "install.toml": "install.toml",
    },
    # hermit is x86-64 only (detcore virtualizes the x86 cpuid instruction).
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

# Upstream's tests/reproducible-builds/build-time-0.1.3/Cargo.toml, byte for
# byte (cfead539). The import drops every Cargo.toml, because fbsource owns that
# name (hermit_import/prepare.rs), but the manifest planner's test inventory
# requires this fixture file, so the e2e source snapshot
# (//hermetic_infra/hermit/tests:e2e-source-tree) maps it back to its path.
# The open-source tree has the file at that path and no copy here.
buck_export_file(
    name = "e2e-build-time-0.1.3.Cargo.toml",
    target_compatible_with = ["fbcode//opensource/macros:broken-in-oss"],
    visibility = ["//hermetic_infra/hermit/tests:"],
)

# The upstream commits this import came from; the e2e cells record Hermit's as
# the source of their snapshot (ci/buck-e2e :source-sha). Only an imported
# tree has this record.
buck_export_file(
    name = "IMPORTED_SHA",
    target_compatible_with = ["fbcode//opensource/macros:broken-in-oss"],
    visibility = ["//hermetic_infra/hermit/ci/buck-e2e:"],
)
