[package]
name = "detcore-liteinst"
description = "In-guest LiteInst runtime for Detcore, the Hermit deterministic execution engine."
version = "0.4.0"
edition = "2024"
license = "BSD-3-Clause"
repository = "https://github.com/facebookexperimental/hermit"
publish = false

# This crate is a preload runtime, not a testable library. Its `.init_array`
# constructor (src/lib.rs) runs before any Rust test harness and `_exit(127)`s
# when `REVERIE_LITEINST_COORDINATOR` is unset, so a generated unit-test binary
# would abort during `nextest --list`. The test and doctest targets are
# disabled: hermit-cli's in-guest CLI tests run it as a real preload.
[lib]
crate-type = ["cdylib"]
test = false
doctest = false

[dependencies]
detcore = { package = "hermit-detcore", version = "0.4.0", path = "../detcore" }
libc = "0.2.186"
reverie-liteinst = { version = "0.4.1", git = "https://github.com/rrnewton/reverie.git", rev = "c7a1ed25bca339daa0e69241353fc9882da63d7a", default-features = false }
